{{/*
The zero-on-error family: a method answering a value beside an error
returns that value's zero when the error is non-nil.

Two variants because the error is induced two ways and each is a
different statement sequence — one draws an input nothing wrote, the
other cancels a context before calling. What they share is the
judgement, which is the fragment below.

The skip is not a pass. A subject that answered where this check needed
a failure has told us nothing about the claim, and saying so is the
difference between a check that ran and a check that could not.
*/}}
{{- define "suite.body.zero-on-miss" -}}
ctx := tb.Context()
{{ .ZeroBind }} {{ suite_callExpr .Recv .Body.Call }}
if err == nil {
{{- if .Pool }}
	tb.Skipf("{{ .Method }} answered for an input nothing wrote, so this check has no error to "+
		"inspect; seed a miss through {{ .Pool }}")
{{- else }}
	tb.Skipf("{{ .Method }} answered for an input nothing wrote, so this check has no error to inspect")
{{- end }}
}
{{ template "suite.frag.zero-judge" (.ZeroJudge .Body.Because true) }}
{{- end -}}

{{- define "suite.body.zero-on-cancel" -}}
ctx, cancel := {{ renderExpr (external "context" "WithCancel") }}(tb.Context())
cancel()
{{ .ZeroBind }} {{ suite_callExpr .Recv .Body.Call }}
if err == nil {
	tb.Skip("{{ .Method }} answered for a cancelled context, so this check has no error to inspect")
}
{{ template "suite.frag.zero-judge" (.ZeroJudge .Body.Because true) }}
{{- end -}}

{{- /*
The judgement, once per value slot. How each zero is compared comes from
that result's own type, and the split is comparability rather than
spelling: a slice, map or func may only be compared against nil, while
every other type has a zero that can be declared and compared — a named
one through the backend, since that is an import to register, and a
predeclared one by its own word.

Every slot, because the claim is about the whole answer. A read that
zeroes its value and leaks its metadata has told the caller it failed
and handed them state regardless, and a body judging one slot renders
identically to one judging both.
*/ -}}
{{- define "suite.frag.zero-judge" -}}
{{- $j := . }}
{{- range $slot := .Slots }}
{{- if $slot.Empty }}
if len({{ $slot.Bind }}) != 0 {
{{- if $j.ShowErr }}
	tb.Errorf("{{ $j.Method }} must return nothing{{ with $slot.Label }} for its {{ . }}{{ end }} {{ $j.Because }}: got %d (err %v)", len({{ $slot.Bind }}), err)
{{- else }}
	tb.Errorf("{{ $j.Method }} must return nothing{{ with $slot.Label }} for its {{ . }}{{ end }} {{ $j.Because }}: got %d", len({{ $slot.Bind }}))
{{- end }}
}
{{- else if $slot.Nil }}
if {{ $slot.Bind }} != nil {
{{- if $j.ShowErr }}
	tb.Errorf("{{ $j.Method }} must return nothing{{ with $slot.Label }} for its {{ . }}{{ end }} {{ $j.Because }} (err %v)", err)
{{- else }}
	tb.Errorf("{{ $j.Method }} must return nothing{{ with $slot.Label }} for its {{ . }}{{ end }} {{ $j.Because }}")
{{- end }}
}
{{- else }}
var {{ $slot.Zero }} {{ if $slot.Type }}{{ renderExpr $slot.Type }}{{ else }}{{ $slot.Word }}{{ end }}
if {{ $slot.Bind }} != {{ $slot.Zero }} {
{{- if $j.ShowErr }}
	tb.Errorf("{{ $j.Method }} must return the zero {{ with $slot.Label }}{{ . }}{{ else }}value{{ end }} {{ $j.Because }}: got %+v, want %+v (err %v)",
		{{ $slot.Bind }}, {{ $slot.Zero }}, err)
{{- else }}
	tb.Errorf("{{ $j.Method }} must return the zero {{ with $slot.Label }}{{ . }}{{ else }}value{{ end }} {{ $j.Because }}: got %+v, want %+v",
		{{ $slot.Bind }}, {{ $slot.Zero }})
{{- end }}
}
{{- end }}
{{- end }}
{{- end -}}
