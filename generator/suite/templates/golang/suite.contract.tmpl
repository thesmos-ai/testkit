{{- define "suite.contract" -}}
{{ $c := . }}
// Conformance checks for {{ .IfaceName }}, worked out from its declaration.
//
// The package comment above says what these are and how to start. This is
// {{ .IfaceName }}'s half of it — the names to use:
//
//	func TestMine(t *testing.T) {
//		{{ suite_runName .IfaceName }}(t, {{ suite_harnessName .IfaceName }}[*Mine]{Name: "mine", New: NewMine})
//	}
//
//	{{ suite_harnessName .IfaceName }} — one implementation under test
//	{{ suite_rowsName .IfaceName }} — checks of your own, run beside these
//	{{ suite_proveName .IfaceName }} — each of yours against the defect it names
//	{{ suite_greenName .IfaceName }} — all of them against correct-but-different
//	{{ suite_veneerVar .IfaceName }}.Checks.<Method>.<Check>() — one check by identity, so you can drop it
//
// The checks this file runs:
//
{{- range $id := .EmittedIDs }}
//	{{ $id }}
{{- end }}
{{- range $id := .AllContributedIDs }}
//	{{ $id }}
{{- end }}
{{- if .Withheld }}
//
// Claims that could be stated here and are not yet, so nothing below
// checks them. Listed because a missing check is easy to work around
// once you know about it and expensive to discover the hard way:
//
{{- range $w := .Withheld }}
//	{{ $w }}
{{- end }}
{{- end }}
{{- if .Elsewhere }}
//
// Declared on this interface and checked by testkit's model tier rather
// than by this file, which judges one call at a time. Nothing for you to
// do — listed so that a directive you wrote is accounted for:
//
{{- range $e := .Elsewhere }}
//	{{ $e }}
{{- end }}
{{- end }}
{{- if .Gaps }}
//
// Claims this file does NOT make. Each was worked out from your
// declaration and then declined, because something needed to state it
// is missing. The reason and the fix are given for each: the list above
// tells you what you have, and this tells you what you do not.
//
{{- range $g := .Gaps }}
//	{{ $g }}
{{- end }}
{{- end }}
//
// A version check, performed by the compiler. If this file was generated
// against a testkit whose check format differs from the one you are
// building with, this line fails to compile and names the mismatch —
// instead of the two disagreeing quietly while the tests still pass.
// Regenerate the file to clear it.
var _ = {{ renderExpr (external $.Vocab "CompatV2") }}

// {{ $.Fixture.TypeName }} holds the sample inputs the checks call your
// implementation with, worked out from each method's parameter types.
//
// How a field is derived, and what one this run could not derive leaves
// behind, is documented on [{{ renderExpr (external $.Vocab "Row") }}]'s Run field.
type {{ $.Fixture.TypeName }}{{ renderTypeParams $.TypeParams }} struct {
{{- range $f := $.Fixture.Fields }}
	{{ camel $f.Name }} {{ renderType $f.Type }}
	{{ camel $f.OtherName }} {{ renderType $f.Type }}
{{- end }}
{{- range $p := $.Pools }}

	// {{ camel $p.Field }} is the whole {{ $p.Role }} pool this run drew,
	// which is not the same as the two members above: a DERIVED pool
	// carries a hostile member the transforms added, and a pool you passed
	// carries exactly what you passed. See {{ $p.Field }}.
	{{ camel $p.Field }} []{{ renderType $p.Type }}

	// {{ camel $p.Field }}Restricted records that the run narrowed this
	// pool rather than taking the derived one. See {{ $p.Field }}Derived.
	{{ camel $p.Field }}Restricted bool
{{- end }}
}

// {{ $.Fixture.CtorName }} is what a run with no config draws.
func {{ $.Fixture.CtorName }}{{ renderTypeParams $.TypeParams }}() {{ $.Fixture.TypeName }}{{ $.TypeArgs }} {
	return {{ suite_newFixtureName $.Token }}{{ $.TypeArgs }}({{ if $.Pools }}{{ suite_configName $.IfaceName }}{{ $.TypeArgs }}{}{{ end }})
}

// {{ suite_newFixtureName $.Token }} builds the sample inputs for one run.
//
// Read these through the methods below rather than as fields. A value you
// supplied through the config and one worked out from the type are read
// the same way, and no check should be able to tell them apart.
func {{ suite_newFixtureName $.Token }}{{ renderTypeParams $.TypeParams }}(
	{{- if $.Pools }}cfg {{ suite_configName $.IfaceName }}{{ $.TypeArgs }}{{ end -}}
) {{ $.Fixture.TypeName }}{{ $.TypeArgs }} {
{{- if $.Pools }}
	// Compared against the derived pool by VALUE, not by whether one was
	// set. Nil-ness reads the wrong thing the moment a consumer starts
	// from the derived config: take {{ suite_defaultConfigName $.Token }}(),
	// change one unrelated field, and every pool arrives non-nil and
	// equal to the one worked out here. Read as a restriction, the
	// adversarial arm goes silently, the same values are drawn, and the
	// report line is identical — a check that got weaker with nothing to
	// show for it.
	//
	// Read BEFORE the defaults land, because that is the only moment a
	// pool the consumer left empty is still empty.
	derived := {{ suite_defaultConfigName $.Token }}{{ $.TypeArgs }}()
{{- range $p := $.Pools }}
	{{ camel $p.Field }}Restricted := len(cfg.{{ $p.Field }}) > 0 &&
		!{{ renderExpr (external "slices" "Equal") }}(cfg.{{ $p.Field }}, derived.{{ $p.Field }})
{{- end }}
	cfg = cfg.orDefault()
{{- end }}
	return {{ $.Fixture.TypeName }}{{ $.TypeArgs }}{
{{- range $p := $.Pools }}
		{{ camel $p.Field }}:      cfg.{{ $p.Field }},
		{{ camel $p.Field }}Restricted: {{ camel $p.Field }}Restricted,
{{- end }}
{{- range $.Fixture.Fields }}
{{- if .OK }}
		{{ camel .Name }}: {{ if .Pool }}cfg.{{ .Pool }}[0]{{ else if .Companion }}{{ renderExpr .Companion }}(){{ else }}{{ template "suite.value" (.Choose false) }}{{ end }},
{{- if or .Composed .Other.OK .Pool }}
		{{ camel .OtherName }}: {{ if .Pool }}cfg.{{ .Pool }}[1]{{ else }}{{ template "suite.value" (.Choose true) }}{{ end }},
{{- end }}
{{- end }}
{{- end }}
	}
}
{{ range $f := $.Fixture.Fields }}
// {{ $f.Name }} is the {{ camel $f.Name }} the checks call your implementation with.
{{- if $f.Variadic }}
//
// One element of a variadic parameter, not the list. Every generated
// check passes it alone; what a method does with several is a claim only
// a check written by hand can make.
{{- end }}
{{- if not $f.OK }}
//
// The zero value, {{ $f.Reason }}.
//
// The checks that needed a real one are listed above as declined; the
// ones left are the ones a zero can answer.
//
// To give it one, declare the type's Defaults companion beside it — the
// type's name with Defaults appended, taking nothing and returning one —
// and this reads that instead. It is the one place a team has already
// written down what a valid instance looks like, and a derived guess is
// only ever plausible where this type has to be correct.
{{- end }}
func (f {{ $.Fixture.TypeName }}{{ $.TypeArgs }}) {{ $f.Name }}() {{ renderType $f.Type }} { return f.{{ camel $f.Name }} }

{{ if $f.OK -}}
// {{ $f.OtherName }} is a second {{ camel $f.Name }}, guaranteed to differ from the
// first — so a check that expects to find nothing is asking about
// something your implementation has genuinely never been given.
{{- else -}}
// {{ $f.OtherName }} is the zero as well, and equal to {{ $f.Name }}: the pair is
// derived together and neither half could be.
//
// Said out loud because the guarantee this accessor carries everywhere
// else — a second value that differs — is what makes a not-found check
// mean anything. One comparing a zero against a zero finds something every
// time while reading exactly as though it had not.
{{- end }}
func (f {{ $.Fixture.TypeName }}{{ $.TypeArgs }}) {{ $f.OtherName }}() {{ renderType $f.Type }} { return f.{{ camel $f.OtherName }} }
{{ end }}
{{- range $p := $.Pools }}
// {{ $p.Field }} is every {{ $p.Role }} this run draws from, which is more
// than the pair above.
//
// The pair is what a fixed call sequence needs: one value and a second
// guaranteed to differ. This is what a DRAWN sequence needs, and the
// difference is the hostile member — a control sequence, a broken rune —
// that the transforms add to a pool derived from the type and that a pool
// you passed does not carry.
//
// Which is the whole provenance rule, and it needs no flag: a derived
// pool is a guess and attacking a guess costs nothing, while a pool you
// passed is a statement about what the implementation accepts. Pass one
// and the hostile member is simply not in it.
func (f {{ $.Fixture.TypeName }}{{ $.TypeArgs }}) {{ $p.Field }}() []{{ renderType $p.Type }} {
	return f.{{ camel $p.Field }}
}

// {{ $p.Field }}Derived reports that this run took the {{ $p.Role }} pool as
// derived rather than as one you supplied.
//
// The hostile member above is one value. This is what licenses reaching
// past it: a derived pool is a guess from the type, and a tier may widen a
// guess as far as it likes because nobody has said what the implementation
// accepts. A pool you passed IS that statement, and probing past it reds
// correct code against inputs you ruled out.
func (f {{ $.Fixture.TypeName }}{{ $.TypeArgs }}) {{ $p.Field }}Derived() bool {
	return !f.{{ camel $p.Field }}Restricted
}
{{ end }}

{{- if .Pools }}
{{ template "suite.config" $c }}
{{- end }}

{{ template "suite.harness" $c }}

{{ template "suite.index" $c }}

{{ template "suite.checks" $c }}

{{ template "suite.rows" $c }}

{{ template "suite.run" $c }}
{{- range (slot $c $c.DeclsSlotName).Items }}

{{ render . }}
{{- end }}
{{- end -}}

{{- /*
suite.value spells one derived value, whole or composed from its fields. A
struct is composed rather than carried as text because a field whose own type is
a struct needs its type spelled beside its braces, and only the backend knows
how to spell it for this file and register the import it needs.
*/ -}}
{{- define "suite.value" -}}
{{- if .Parts }}{{ renderType .Type }}{
{{- range $i, $p := .Parts }}{{ if $i }}, {{ end }}{{ $p.Name }}: {{ if $p.Pool }}cfg.{{ $p.Pool }}[{{ $.Alternate }}]{{ else }}{{ renderSample $p.Value }}{{ end }}{{ end -}} }
{{- else }}{{ renderSample .Value }}{{ end }}
{{- end -}}

