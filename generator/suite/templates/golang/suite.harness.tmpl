{{- /*
suite.harness — the run surface a consumer declares against.

The harness is the one place a consumer says what their implementation
is, so it carries only what this interface's checks can actually demand:
a capability field with no check behind it is a promise the run never
collects on, and one a check needs and the harness cannot express is a
check that skips for a reason nobody can see. HarnessOf projects it from
the plans for exactly that reason.
*/ -}}
{{- define "suite.harness" -}}
{{- $c := . }}
// {{ .IfaceName }} is your interface, under a local name.
//
// An alias, so it is the same type — this is here only so the rest of
// this file can refer to it without repeating its import path, and so a
// check you write can name it too.
type {{ .IfaceName }}{{ renderTypeParams .TypeParams }} = {{ renderType .IfaceRef }}{{ .TypeArgs }}
{{- if .Limit }}

// {{ suite_limitConst .Token }} is the capacity your declaration gave as
// limit={{ .Limit }}, and the capacity your constructor is called with.
//
// It is passed in rather than left for you to repeat, because an
// implementation built at some other capacity would be measured against a
// limit it was never given — and that check would pass without meaning
// anything.
const {{ suite_limitConst .Token }} = {{ .Limit }}
{{- end }}
{{- if .Seeded }}

// {{ suite_corpusTypeName .IfaceName }} is the starting data your constructor is handed:
// the keys the checks will ask for, mapped to the values they expect back.
type {{ suite_corpusTypeName .IfaceName }} = map[{{ renderType .Corpus.Key.Type }}]{{ renderType .Corpus.Value.Type }}
{{- end }}

// {{ .IfaceName }}Subject is what a RunWith check receives instead of a single
// instance: a handle that can build more of them.
//
// Use it for a claim one instance cannot state on its own — that two
// instances do not share state, that a value survives being closed and
// reopened.
type {{ .IfaceName }}Subject{{ renderTypeParams .TypeParams }} = {{ renderExpr (external $.Vocab "Subject") }}[{{ suite_subjectType $c }}]

// {{ suite_runOptName .IfaceName }} is anything you can pass to {{ suite_runName .IfaceName }}: an
// implementation to test, a table of your own checks, a config, or a
// check to drop. Order does not matter.
type {{ suite_runOptName .IfaceName }}{{ renderTypeParams .TypeParams }} interface {
	applyTo(*{{ suite_runConfigName .Token }}{{ .TypeArgs }})
}

type {{ suite_runConfigName .Token }}{{ renderTypeParams .TypeParams }} struct {
	{{ renderExpr (external $.Vocab "Bundle") }}[{{ suite_subjectType $c }}]

	// rows are the checks you wrote, held until every argument has been
	// read and then tied to this run's inputs. Tying them on arrival
	// would bind them to inputs a later argument replaces.
	rows {{ suite_rowsName $c.IfaceName }}{{ $c.TypeArgs }}
{{- if .Pools }}

	// cfg is the pools this run draws from, the zero value meaning the
	// derived ones. Held rather than applied, for the same reason the
	// rows are: the fixture is built once, after every option has had
	// its say.
	cfg {{ suite_configName $c.IfaceName }}{{ $c.TypeArgs }}
{{- end }}
}

{{- if .Harness.Induce }}
// Inductions says how to put your implementation into a failure state.
//
// A check that asks what happens after a particular error has to be able
// to cause that error first. Map the error to a function that provokes
// it, and the checks that need it can run.
type Inductions[T any] = {{ renderExpr (external $.Vocab "Inductions") }}[T]

{{ end }}
// {{ suite_harnessName .IfaceName }} describes one {{ .IfaceName }} implementation to test.
//
// Name and one constructor are all that is required. Every other field
// unlocks the checks that need it, and you do not have to work out which
// in advance: run it, and any check that needs more fails saying which
// field to add.
type {{ suite_harnessName .IfaceName }}{{ suite_withParam (renderTypeParams .TypeParams) (printf "T %s%s" .IfaceName .TypeArgs) }} struct {
	Name string
{{- if .Seeded }}

	// Set exactly one. Both are handed the starting data to load.
	//
	// {{ .IfaceName }} has no method that writes, so the checks cannot fill an
	// instance through the interface itself — they need you to hand back
	// one already holding the data. Without that, a read returning
	// nothing could equally mean "correctly empty" or "broken", and no
	// check could tell the difference.
	//
	// Use Seed if construction cannot fail; use StartSeed if it needs the
	// test's lifetime — a temp directory, a connection to close.
	Seed      func(docs {{ suite_corpusTypeName $c.IfaceName }}) T
	StartSeed func(tb {{ renderExpr (external "testing" "TB") }}, docs {{ suite_corpusTypeName $c.IfaceName }}) T
{{- else }}

	// Set exactly one{{ if .Limit }}. Both are called with the declared capacity{{ end }}.
	//
	// Use New if construction cannot fail; use Start if it needs the
	// test's lifetime — a temp directory to clean up, a connection to
	// close. Start is handed the testing.TB to register that on.
	New   func({{ if .Limit }}capacity int{{ end }}) T
	Start func(tb {{ renderExpr (external "testing" "TB") }}{{ if .Limit }}, capacity int{{ end }}) T
{{- end }}

	// Excuse lists checks this implementation cannot meaningfully take —
	// not ones it fails, ones it has no way to answer. An in-memory
	// implementation has no storage to survive a restart, so a check
	// about restarting it is asking the impossible.
	//
	// Excused checks are reported as excused, never as passed.
	Excuse []{{ renderExpr (external $.Vocab "ID") }}

	// Oracle marks this implementation as the one others are compared
	// against, when you are testing more than one. At most one may set it.
	// Pick the implementation you trust most.
	Oracle bool

	// Serial runs this implementation's checks one at a time, and never
	// alongside another implementation's. Set it for something that
	// cannot take being constructed many times at once — a real database,
	// a fixed port.
	Serial bool
{{- if .Harness.Clock }}

	// Clock is the time source your implementation reads. Checks about
	// expiry move it forward instead of waiting.
	//
	// Required, because those checks cannot state anything otherwise: an
	// implementation reading the real clock would have to be waited on in
	// real time, so the check would either take minutes or assert nothing.
	Clock {{ renderType $.ClockRef }}
{{- end }}
{{- range (slot $c $c.FieldsSlotName).Items }}

	{{ render . }}
{{- end }}
{{- if .Harness.Induce }}

	// Induce maps each error to a function that puts your implementation
	// into the state that error describes.
	//
	// A map rather than a single function because the states are
	// different: a check about a closed instance and one about a failed
	// instance both need to get there first, and each names the state it
	// wants by its error. With one function the harness could not tell
	// which was being asked for.
	Induce Inductions[T]
{{- end }}
{{- if .Harness.Recover }}

	// Recover reopens whatever the previous instance left behind, without
	// letting it shut down cleanly first — what a crash and restart
	// would do.
	//
	// It takes the previous instance because the storage belongs to that
	// instance: its directory, its file. A constructor with no handle on
	// it could only reopen something shared, and then every check would be
	// looking at the same state.
	Recover func(tb {{ renderExpr (external "testing" "TB") }}, subject {{ suite_subjectType $c }}) {{ .IfaceName }}
{{- end }}

	// Provide supplies anything a check needs that has no field of its
	// own above. You will not need it unless a check fails asking for a
	// named capability, and that failure tells you the name to use here.
	Provide map[{{ renderExpr (external $.Vocab "Capability") }}]any
}

// Subject converts this description into the form the runner uses, and
// reports anything wrong with it — no constructor, or two.
func (h {{ suite_harnessName .IfaceName }}{{ suite_withParam .TypeArgs "T" }}) Subject(
	{{- if .Seeded }}docs {{ suite_corpusTypeName $c.IfaceName }}{{ end -}}
) ({{ renderExpr (external $.Vocab "Subject") }}[{{ suite_subjectType $c }}], error) {
{{- if .Seeded }}
	var plain func() T
	if h.Seed != nil {
		plain = func() T { return h.Seed(docs) }
	}
	var start func(tb {{ renderExpr (external "testing" "TB") }}) T
	if h.StartSeed != nil {
		start = func(tb {{ renderExpr (external "testing" "TB") }}) T { return h.StartSeed(tb, docs) }
	}
	build, err := {{ renderExpr (external $.Vocab "OneCtor") }}(h.Name, plain, start)
{{- else if .Limit }}
	// The capacity is bound in before the constructors are checked, so
	// your constructor and the checks agree about what it is.
	var plain func() T
	if h.New != nil {
		plain = func() T { return h.New({{ suite_limitConst .Token }}) }
	}
	var start func(tb {{ renderExpr (external "testing" "TB") }}) T
	if h.Start != nil {
		start = func(tb {{ renderExpr (external "testing" "TB") }}) T { return h.Start(tb, {{ suite_limitConst .Token }}) }
	}
	build, err := {{ renderExpr (external $.Vocab "OneCtor") }}(h.Name, plain, start)
{{- else }}
	build, err := {{ renderExpr (external $.Vocab "OneCtor") }}(h.Name, h.New, h.Start)
{{- end }}
	if err != nil {
		return {{ renderExpr (external $.Vocab "Subject") }}[{{ suite_subjectType $c }}]{}, err
	}
	return {{ renderExpr (external $.Vocab "Subject") }}[{{ suite_subjectType $c }}]{
		Name:     h.Name,
		Provides: h.Provide,
		New:      func(tb {{ renderExpr (external "testing" "TB") }}) {{ suite_subjectType $c }} { return build(tb) },
		Oracle:   h.Oracle,
		Serial:   h.Serial,
		Excused:  {{ renderExpr (external $.Vocab "ExcuseSet") }}(h.Excuse),
{{- if .Harness.Induce }}
		Induces:  {{ renderExpr (external $.Vocab "LowerInductions") }}[{{ suite_subjectType $c }}](h.Name, h.Induce),
{{- end }}
	}, nil
}

func (h {{ suite_harnessName .IfaceName }}{{ suite_withParam .TypeArgs "T" }}) applyTo(rc *{{ suite_runConfigName .Token }}{{ .TypeArgs }}) {
	rc.AddSubject(h.Subject({{ if .Seeded }}{{ suite_corpusName .Token }}({{ if .Pools }}rc.cfg{{ end }}){{ end }}))
}

type {{ suite_dropOptName .Token }}{{ renderTypeParams .TypeParams }} []{{ renderExpr (external $.Vocab "ID") }}

func (d {{ suite_dropOptName .Token }}{{ .TypeArgs }}) applyTo(rc *{{ suite_runConfigName .Token }}{{ .TypeArgs }}) {
	rc.AddDrops(d...)
}

// {{ suite_withoutName .Token }} drops the named checks from the run.
func {{ suite_withoutName .Token }}{{ renderTypeParams .TypeParams }}(ids ...{{ renderExpr (external $.Vocab "ID") }}) {{ suite_runOptName .IfaceName }}{{ .TypeArgs }} {
	return {{ suite_dropOptName .Token }}{{ .TypeArgs }}(ids)
}

{{- if .Seeded }}

// {{ suite_corpusName .Token }} builds the starting data every implementation is
// loaded with: one entry per key, values reused in order if there are
// fewer of them.
//
// Worked out rather than asked for, so that two implementations in the
// same run start from identical data. If you supplied them separately
// and they differed, a comparison between the two would be measuring
// your setup rather than their behaviour.
func {{ suite_corpusName .Token }}({{ if .Pools }}cfg {{ suite_configName .IfaceName }}{{ end }}) {{ suite_corpusTypeName $c.IfaceName }} {
{{- if .Pools }}
	cfg = cfg.orDefault()
{{- end }}
	docs := make({{ suite_corpusTypeName $c.IfaceName }}, len(cfg.{{ .Corpus.Key.Field }}))
	for i, k := range cfg.{{ .Corpus.Key.Field }} {
		docs[k] = cfg.{{ .Corpus.Value.Field }}[i%len(cfg.{{ .Corpus.Value.Field }})]
	}
	return docs
}

// {{ suite_missKeyName .Token }} is a key deliberately left out of that data.
//
// Checks that expect to find nothing use this one. They cannot use the
// fixture's second key, because every key in the pool gets loaded — so
// that one is present too, and a check using it would find something
// while claiming to find nothing.
func {{ suite_missKeyName .Token }}() {{ renderType .Corpus.Key.Type }} {
	return {{ .Corpus.MissKey }}
}
{{- end }}

// --- Naming checks ----------------------------------------------------------

// {{ suite_veneerVar .IfaceName }} is how you name a check — to drop it, or to
// point at it from a tool.
var {{ suite_veneerVar .IfaceName }} = {{ suite_veneerName .Token }}{Checks: {{ suite_indexVar .Token }}}

type {{ suite_veneerName .Token }} struct {
	// Checks names every check this file runs, by method:
	//
	//	{{ suite_veneerVar $.IfaceName }}.Checks.<Method>.<Check>()
	//
	// Prefer this over writing the check's name as a string. If a later
	// regeneration stops emitting that check, this stops compiling —
	// where the string would silently drop nothing.
	Checks {{ suite_indexType .Token }}
}

{{- if .TypeParams }}
// {{ suite_exportedWithout .IfaceName }} drops the named checks from the run.
//
// A function rather than a method, because {{ .IfaceName }} is generic and a
// method could not carry its type arguments. Naming the checks reads the
// same either way.
func {{ suite_exportedWithout .IfaceName }}{{ renderTypeParams .TypeParams }}(
	ids ...{{ renderExpr (external $.Vocab "ID") }},
) {{ suite_runOptName .IfaceName }}{{ .TypeArgs }} {
	return {{ suite_withoutName .Token }}{{ .TypeArgs }}(ids...)
}

// {{ suite_exportedSuiteOf .IfaceName }} returns the checks as plain data, if you are
// building a tool over them or running them yourself.
//
// A function rather than a method for the same reason
// {{ suite_exportedWithout .IfaceName }} is: {{ .IfaceName }} is generic.
func {{ suite_exportedSuiteOf .IfaceName }}{{ renderTypeParams .TypeParams }}(
	{{- if .DrawsFixture }}{{ suite_fixtureIdent }} {{ .Fixture.TypeName }}{{ .TypeArgs }}{{ end }}
	{{- if and .DrawsFixture .SeedsCorpus }}, {{ end }}
	{{- if .SeedsCorpus }}{{ suite_docsIdent }} {{ suite_corpusTypeName .IfaceName }}{{ end -}}
) {{ renderExpr (external $.Vocab "Suite") }}[{{ .IfaceName }}{{ .TypeArgs }}] {
	return {{ suite_suiteName .Token }}{{ .TypeArgs }}(
		{{- if .DrawsFixture }}{{ suite_fixtureIdent }}{{ end }}
		{{- if and .DrawsFixture .SeedsCorpus }}, {{ end }}
		{{- if .SeedsCorpus }}{{ suite_docsIdent }}{{ end -}}
	)
}
{{- else }}
// Without drops the named checks from the run.
//
//	{{ suite_runName $.IfaceName }}(t, mine, {{ suite_veneerVar $.IfaceName }}.Without(
//		{{ suite_veneerVar $.IfaceName }}.Checks{{ with index $.Methods 0 }}.{{ .Name }}.Smoke(){{ end }}))
//
// Dropping is recorded in the run's report, so a check you removed is
// visible rather than simply absent.
func ({{ suite_veneerName .Token }}) Without(ids ...{{ renderExpr (external $.Vocab "ID") }}) {{ suite_runOptName .IfaceName }} {
	return {{ suite_withoutName .Token }}(ids...)
}

// Suite returns the checks as plain data, if you are building a tool over
// them or running them yourself.
//
// {{ suite_runName $.IfaceName }} is the normal way in; this is for when you need the
// checks as values rather than as a run.
func ({{ suite_veneerName .Token }}) Suite(
	{{- if .DrawsFixture }}{{ suite_fixtureIdent }} {{ .Fixture.TypeName }}{{ end }}
	{{- if and .DrawsFixture .SeedsCorpus }}, {{ end }}
	{{- if .SeedsCorpus }}{{ suite_docsIdent }} {{ suite_corpusTypeName .IfaceName }}{{ end -}}
) {{ renderExpr (external $.Vocab "Suite") }}[{{ .IfaceName }}] {
	return {{ suite_suiteName .Token }}(
		{{- if .DrawsFixture }}{{ suite_fixtureIdent }}{{ end }}
		{{- if and .DrawsFixture .SeedsCorpus }}, {{ end }}
		{{- if .SeedsCorpus }}{{ suite_docsIdent }}{{ end -}}
	)
}
{{- if .Pools }}

// DefaultConfig is the sample inputs this file worked out for itself.
//
// Start from it when you want to change one thing and keep the rest —
// take it, set the field you care about, and pass it to {{ suite_runName $.IfaceName }}.
func ({{ suite_veneerName .Token }}) DefaultConfig() {{ suite_configName .IfaceName }} {
	return {{ suite_defaultConfigName .Token }}()
}

{{- if .Limit }}

// DeclaredLimit is the capacity your declaration gave.
//
// Read it from here rather than writing the number again: two copies of
// a limit drift apart, and the checks use this one.
func ({{ suite_veneerName .Token }}) DeclaredLimit() int { return {{ suite_limitConst .Token }} }
{{- end }}

// TrySuite is Suite for a config you built yourself, returning an error
// instead of panicking if it is unusable.
//
// Suite panics on a bad config because it has no test to report through.
// If you are assembling a config in code rather than passing it straight
// to {{ suite_runName $.IfaceName }}, use this and handle the error.
func ({{ suite_veneerName .Token }}) TrySuite(cfg {{ suite_configName .IfaceName }}) ({{ renderExpr (external $.Vocab "Suite") }}[{{ .IfaceName }}], error) {
	if _, err := cfg.normalize(); err != nil {
		return {{ renderExpr (external $.Vocab "Suite") }}[{{ .IfaceName }}]{}, err
	}
	return {{ suite_suiteName .Token }}(
		{{- if .DrawsFixture }}{{ suite_newFixtureName .Token }}(cfg){{ end }}
		{{- if and .DrawsFixture .SeedsCorpus }}, {{ end }}
		{{- if .SeedsCorpus }}{{ suite_corpusName .Token }}(cfg){{ end -}}
	), nil
}
{{- end }}
{{- end }}

{{- if .Seeded }}

// Corpus is the starting data a default run loads every implementation
// with — the same map your constructor is handed.
//
// Useful when a check you write needs to know what was loaded.
func ({{ suite_veneerName .Token }}) Corpus() {{ suite_corpusTypeName .IfaceName }} {
	return {{ suite_corpusName .Token }}({{ if .Pools }}{{ suite_defaultConfigName .Token }}(){{ end }})
}
{{- end }}

// --- Failure messages -------------------------------------------------------

// {{ suite_indexPathName .Token }} maps each check to the expression you would
// write to drop it, so that a check which cannot run tells you what to
// type rather than only what went wrong.
var {{ suite_indexPathName .Token }} = map[{{ renderExpr (external $.Vocab "ID") }}]string{
{{- range $g := .Index.Groups }}
{{- range $a := $g.Accessors }}
	{{ suite_indexVar $c.Token }}.{{ $g.Field }}.{{ $a.Name }}(): "{{ suite_veneerVar $c.IfaceName }}.Checks.{{ $g.Field }}.{{ $a.Name }}()",
{{- end }}
{{- end }}
}

var {{ suite_dropHintName .Token }} = {{ renderExpr (external $.Vocab "DropHinter") }}(
	"{{ suite_veneerVar .IfaceName }}", {{ suite_indexPathName .Token }},
)
{{- end -}}
