{{- /*
suite.index — the method-name constants and the typed check index.

The index is what a Without call is written against, so it is spelled as
types rather than as strings: a check that is renamed or retired breaks
the consumer who named it, which is the whole point of dropping by
identity. Every ID is composed through the runtime's own constructors
from the runtime's own segment constants, so the grammar has one home
and this file only assembles it.
*/ -}}
{{- define "suite.index" -}}
{{- $c := . }}
// The names this file uses in more than one place, declared once each so
// they cannot drift apart.
const (
{{- range $m := .Methods }}
	{{ suite_methodConst $c.Token $m.Name }} = {{ printf "%q" $m.Name }}
{{- end }}
{{- if .CheckIndex.HasFamily }}

	// The interface's word inside a family-scoped identity.
	{{ suite_qualifierConst $c.Token }} = {{ printf "%q" $c.Qualifier }}
{{- end }}
)

// {{ suite_indexVar .Token }} names every check in this file, grouped by method.
// Reach it through {{ suite_veneerVar .IfaceName }}.Checks.
var {{ suite_indexVar .Token }} = {{ suite_indexType .Token }}{
{{- range $g := .CheckIndex.Groups }}
	{{ $g.Field }}: {{ suite_groupType $c.Token $g.Field }}{},
{{- end }}
}

type {{ suite_indexType .Token }} struct {
{{- range $g := .CheckIndex.Groups }}
	{{ $g.Field }} {{ suite_groupType $c.Token $g.Field }}
{{- end }}
}

// All returns every ID this package emits.
func ({{ suite_indexType .Token }}) All() []{{ renderExpr (external $.Vocab "ID") }} {
	var out []{{ renderExpr (external $.Vocab "ID") }}
{{- range $g := .CheckIndex.Groups }}
	out = append(out, {{ suite_groupType $c.Token $g.Field }}{}.All()...)
{{- end }}
	return out
}
{{ range $g := .CheckIndex.Groups }}
type {{ suite_groupType $c.Token $g.Field }} struct{}
{{ range $a := $g.Accessors }}
func ({{ suite_groupType $c.Token $g.Field }}) {{ $a.Name }}() {{ renderExpr (external $.Vocab "ID") }} {
{{- if $g.Method }}
	return {{ renderExpr (external $.Vocab "MethodID") }}({{ suite_methodConst $c.Token $g.Method }}, {{ renderExpr (external $.Vocab $a.SegConst) }})
{{- else }}
	return {{ renderExpr (external $.Vocab "FamilyID") }}({{ renderExpr (external $.Vocab $g.FamilyConst) }}, {{ suite_qualifierConst $c.Token }}, {{ if $a.LawConst }}{{ renderExpr (external $.LawIDs $a.LawConst) }}{{ else }}{{ renderExpr (external $.Vocab $a.SegConst) }}{{ end }})
{{- end }}
}
{{ end }}
func ({{ suite_groupType $c.Token $g.Field }}) All() []{{ renderExpr (external $.Vocab "ID") }} {
	return []{{ renderExpr (external $.Vocab "ID") }}{
{{- range $a := $g.Accessors }}
		{{ suite_groupType $c.Token $g.Field }}{}.{{ $a.Name }}(),
{{- end }}
	}
}
{{ end }}
{{- end -}}
