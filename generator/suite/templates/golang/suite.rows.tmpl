{{- /*
suite.rows — the table a consumer writes their own checks in.

The seam this whole surface exists to offer. A generated check and a
hand-written one are the same runtime type, so everything that works on
one works on the other: the same report, the same drop path, the same
lock row, the same proof.

Which body field a row fills decides what that body receives, and that
is why they are separate fields rather than one function plus a mode: a
body handed the subject can build two instances and move a clock
between them, and a body handed one instance cannot. The difference is
structural, not a flag.
*/ -}}
{{- define "suite.rows" -}}
{{- $c := . }}
// {{ suite_defectTypeName .IfaceName }} is a deliberately broken implementation, used as
// evidence that a check can fail. In practice you build one with
// {{ suite_brokenName .IfaceName }} over the generated test double.
type {{ suite_defectTypeName .IfaceName }}{{ renderTypeParams .TypeParams }} interface {
	Subject({{ if .Seeded }}docs {{ suite_corpusTypeName .IfaceName }}{{ end }}) ({{ .IfaceName }}Subject{{ .TypeArgs }}, error)
}

// {{ suite_brokenName .IfaceName }} describes an implementation built to break one
// specific claim, so that a check can be shown to catch it.
//
// Give it a name saying what is wrong, and a constructor. The best
// broken implementation is the generated double wrapping a correct one,
// with a single method overridden — correct everywhere except the one
// place the check is about.
{{- if .Seeded }}
//
// It receives the same starting data a real implementation would, since
// what you are breaking here is what it does with what it was given.
{{- end }}
func {{ suite_brokenName .IfaceName }}{{ suite_withParam (renderTypeParams .TypeParams) (printf "T %s%s" .IfaceName .TypeArgs) }}(
	name string, build func({{ if .Seeded }}docs {{ suite_corpusTypeName .IfaceName }}{{ else if .Limit }}capacity int{{ end }}) T,
) {{ suite_harnessName .IfaceName }}{{ suite_withParam .TypeArgs "T" }} {
	return {{ suite_harnessName .IfaceName }}{{ suite_withParam .TypeArgs "T" }}{
		Name: name, {{ if .Seeded }}Seed{{ else }}New{{ end }}: build,
	}
}

// {{ suite_rowsName .IfaceName }} is a table of checks you write yourself, for the
// claims that cannot be worked out from the declaration — the ones that
// carry your domain.
//
// They are the same kind of value as the generated checks: they appear
// in the report, they can be dropped by name, and they can say what they
// need from an implementation. There is no second mechanism for them.
//
//	var myChecks = {{ suite_rowsName .IfaceName }}{
//		{{ with index .Methods 0 }}{Method: "{{ .Name }}", Name: "my-claim",{{ end }}
//			Claim:    "a sentence stating exactly what this check proves",
//			Run:      myClaimBody,
//			ProvenBy: {{ suite_brokenName .IfaceName }}("an implementation that breaks it", newBroken)},
//	}
type {{ suite_rowsName .IfaceName }}{{ renderTypeParams .TypeParams }} []{{ suite_rowName .IfaceName }}{{ .TypeArgs }}

func (c {{ suite_rowsName .IfaceName }}{{ .TypeArgs }}) applyTo(rc *{{ suite_runConfigName .Token }}{{ .TypeArgs }}) {
	rc.rows = append(rc.rows, c...)
}

// {{ suite_rowName .IfaceName }} is one check you wrote. The body is a plain named
// function; which field you put it in decides what it is handed.
//
// Every field down to Argued is documented on [{{ renderExpr (external $.Vocab "Row") }}], which is
// what this becomes when the run binds it. The fields after them are this
// interface's own — they name the types its methods draw — and are
// documented here.
type {{ suite_rowName .IfaceName }}{{ renderTypeParams .TypeParams }} struct {
	Method       string
	Name         string
	Claim        string
	Run          func(tb {{ renderExpr (external "testing" "TB") }}, s {{ suite_subjectType $c }}, {{ suite_fixtureIdent }} {{ .Fixture.TypeName }}{{ .TypeArgs }})
	RunWith      func(tb {{ renderExpr (external "testing" "TB") }}, sub {{ .IfaceName }}Subject{{ .TypeArgs }}, {{ suite_fixtureIdent }} {{ .Fixture.TypeName }}{{ .TypeArgs }})
	Class        {{ renderExpr (external $.Vocab "Class") }}
	Needs        {{ renderExpr (external $.Vocab "Caps") }}
	ProvenBy     {{ suite_defectTypeName .IfaceName }}{{ .TypeArgs }}
	ProvenReason string
	Argued       string
{{- range (slot $c $c.CheckFieldsSlotName).Items }}

	{{ render . }}
{{- end }}
}

// {{ suite_methodsVar .Token }} is the interface's method names, used to catch a typo in
// a check's Method field before the run starts.
//
// Without it a misspelled name would be accepted — it looks like any
// other method name — and the check would be filed under a method that
// does not exist, where nobody could find or drop it.
var {{ suite_methodsVar .Token }} = {{ renderExpr (external $.Vocab "NewNameSet") }}("{{ .IfaceName }}"
	{{- range .Methods }}, {{ suite_methodConst $c.Token .Name }}{{ end }})

// bind converts one of your checks into the form the runner uses, tying
// it to this run's sample inputs — which is what lets a check you wrote
// see the same values, and the same overrides, as the generated ones.
func (c {{ suite_rowName .IfaceName }}{{ .TypeArgs }}) bind(
	{{ suite_fixtureIdent }} {{ .Fixture.TypeName }}{{ .TypeArgs }},
) ({{ renderExpr (external $.Vocab "Check") }}[{{ suite_subjectType $c }}], error) {
	b := {{ renderExpr (external $.Vocab "BindRow") }}({{ renderExpr (external $.Vocab "Row") }}[{{ suite_subjectType $c }}, {{ .Fixture.TypeName }}{{ .TypeArgs }}]{
		Method: c.Method, Name: c.Name, Claim: c.Claim,
		Run: c.Run, RunWith: c.RunWith,
		Class: c.Class, Needs: c.Needs,
		Proven: c.ProvenBy != nil, ProvenReason: c.ProvenReason, Argued: c.Argued,
	}, {{ suite_fixtureIdent }}, {{ suite_methodsVar .Token }})
{{- range (slot $c $c.CheckBodiesSlotName).Items }}
	{{ render . }}
{{- end }}
	return b.Seal(c.Method)
}
{{- end -}}
