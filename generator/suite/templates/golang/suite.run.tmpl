{{- /*
suite.run — the two entry points.

Run drives every check, generated and yours, against every declared
harness. Prove drives each of your rows against the defect it names.
They take the same options and bind to the same fixture on purpose: a
check proven against inputs no run uses is evidence about nothing.

Both fold the options before doing anything, then report every wiring
error at once. A run that failed on the first misconfiguration would
make a consumer fix four things in four cycles.
*/ -}}
{{- define "suite.run" -}}
{{- $c := . }}
// {{ suite_runName .IfaceName }} runs every check — the generated ones and any you
// wrote — against every implementation you pass it.
//
// Each argument describes one thing to do, in any order: an
// implementation to test, a table of your own checks, sample inputs to
// use, or checks to leave out.
//
//	{{ suite_runName .IfaceName }}(t,
//		{{ suite_harnessName .IfaceName }}[*InMemory]{Name: "in-memory", New: NewInMemory},
//		{{ if .TypeParams }}{{ suite_exportedWithout .IfaceName }}{{ .TypeArgs }}{{ else }}{{ suite_veneerVar .IfaceName }}.Without{{ end }}({{ suite_veneerVar .IfaceName }}.Checks{{ with index .Methods 0 }}.{{ .Name }}.Smoke(){{ end }}),
//	)
//
// Pass two implementations to compare them against each other, and mark
// the one you trust as the Oracle. Every check runs as its own subtest
// named after the implementation and the check, so `go test -run` can
// select one.
//
// A check that needs something your implementation has not supplied
// fails rather than skipping, and says which field to fill in. That is
// deliberate: a skipped check is how a claim goes unchecked while the
// run stays green.
func {{ suite_runName .IfaceName }}{{ renderTypeParams .TypeParams }}(
	t *{{ renderExpr (external "testing" "T") }}, opts ...{{ suite_runOptName .IfaceName }}{{ .TypeArgs }},
) {
	t.Helper()
	var rc {{ suite_runConfigName .Token }}{{ .TypeArgs }}
	for _, o := range opts {
		o.applyTo(&rc)
	}
	{{ suite_fixtureIdent }} := {{ suite_newFixtureName .Token }}{{ .TypeArgs }}({{ if .Pools }}rc.cfg{{ end }})
	for _, row := range rc.rows {
		rc.AddCheck(row.bind({{ suite_fixtureIdent }}))
	}
	// Checked here, after reading every argument and before running
	// anything: a misconfigured run reports all of its problems at once
	// rather than one per attempt.
	rc.Fail(t, "{{ suite_runName .IfaceName }}")
	{{ renderExpr (external $.Vocab "Run") }}(t,
		{{ suite_suiteName .Token }}{{ .TypeArgs }}(
			{{- if .DrawsFixture }}{{ suite_fixtureIdent }}{{ end }}
			{{- if and .DrawsFixture .SeedsCorpus }}, {{ end }}
			{{- if .SeedsCorpus }}{{ suite_corpusName .Token }}({{ if .Pools }}rc.cfg{{ end }}){{ end -}}
		).With(rc.Extra...).Without(rc.Drops...),
		rc.Subjects...)
}

{{ if .Provable }}
// {{ suite_proofsName .Token }} is every defect this run derived and can spell.
//
// Each is the smallest implementation that breaks exactly one claim: the
// generated double with one method overridden, and nothing else changed.
// The reason beside it is the substring the red must contain, so a defect
// that died on an unrelated guard stops counting as evidence.
//
// Unexported and built fresh per call. A defect carries a constructor
// that registers cleanup on the test it is handed, so a shared map would
// hand one test's cleanup to the next.
func {{ suite_proofsName .Token }}() {{ renderExpr (external $.Prove "Defects") }}[{{ suite_subjectType $c }}] {
	ix := {{ suite_veneerVar .IfaceName }}.Checks
	return {{ renderExpr (external $.Prove "Defects") }}[{{ suite_subjectType $c }}]{
{{- range $d := .Defects.Rows }}
		ix.{{ $d.Group }}.{{ $d.Accessor }}(): {{ render $d }},
{{- end }}
	}
}
{{ end }}
// {{ suite_proveName .IfaceName }} runs every check — the generated ones and any you
// wrote — against the deliberately broken implementation it names, and
// fails if the check does not catch it.
//
//	func TestMyChecksCanFail(t *testing.T) {
//		{{ suite_proveName .IfaceName }}(t, {{ suite_harnessName .IfaceName }}[*InMemory]{Name: "in-memory", New: NewInMemory}, myChecks)
//	}
//
// A check that always passes is indistinguishable from a working one
// until something breaks in production. This is what tells them apart:
// give each check a ProvenBy, and this proves the check can fail.
//
// A check with no ProvenBy is not ignored — it has to say why, in
// Argued. The two are held level in both directions: claiming proof
// without a broken implementation fails here, and supplying one for a
// check that claims nothing fails too.
//
// It takes the same arguments {{ suite_runName .IfaceName }} does, and for one reason: a
// check may need a capability, and the answer is a fact about this
// interface rather than about any one implementation. The harness is
// where you write it once. A planted defect stands in for a real
// subject, so it borrows the same answer rather than being asked for one
// of its own — which nothing here could supply.
func {{ suite_proveName .IfaceName }}{{ renderTypeParams .TypeParams }}(
	t *{{ renderExpr (external "testing" "T") }}, opts ...{{ suite_runOptName .IfaceName }}{{ .TypeArgs }},
) {
	t.Helper()
	var rc {{ suite_runConfigName .Token }}{{ .TypeArgs }}
	for _, o := range opts {
		o.applyTo(&rc)
	}
	// The RUN's config, not the derived one: a check proven at default
	// pools carries no evidence about the pools a run actually uses.
	{{ suite_fixtureIdent }} := {{ suite_newFixtureName .Token }}{{ .TypeArgs }}({{ if .Pools }}rc.cfg{{ end }})
	for _, row := range rc.rows {
		rc.AddCheck(row.bind({{ suite_fixtureIdent }}))
	}
	rc.Fail(t, "{{ suite_proveName .IfaceName }}")
	s := {{ suite_suiteName .Token }}{{ .TypeArgs }}(
		{{- if .DrawsFixture }}{{ suite_fixtureIdent }}{{ end }}
		{{- if and .DrawsFixture .SeedsCorpus }}, {{ end }}
		{{- if .SeedsCorpus }}{{ suite_corpusName .Token }}({{ if .Pools }}rc.cfg{{ end }}){{ end -}}
	).With(rc.Extra...).Without(rc.Drops...)
	// Read off the subjects, because a door is answered once for the
	// interface and every subject of it reads the same answer.
	doors := {{ renderExpr (external $.Vocab "Doors") }}(rc.Subjects...)
	defects := {{ if .Provable }}{{ suite_proofsName .Token }}(){{ else }}{{ renderExpr (external $.Prove "Defects") }}[{{ suite_subjectType $c }}]{}{{ end }}
	for _, row := range rc.rows {
		if row.ProvenBy == nil {
			continue
		}
		bd, err := row.bind({{ suite_fixtureIdent }})
		if err != nil {
			t.Fatalf("{{ suite_proveName .IfaceName }}: %v", err)
		}
		sub, err := row.ProvenBy.Subject({{ if .Seeded }}{{ suite_corpusName .Token }}({{ if .Pools }}rc.cfg{{ end }}){{ end }})
		if err != nil {
			t.Fatalf("{{ suite_proveName .IfaceName }}: check %q: defect: %v", bd.ID, err)
		}
		defects[bd.ID] = {{ renderExpr (external $.Prove "Defect") }}[{{ suite_subjectType $c }}]{
			Subject: sub, Reason: row.ProvenReason,
		}
	}
	// A declined check takes its proof with it: proving a row the run was
	// told to leave out reports on a claim this package no longer makes,
	// and the parity gate fails naming a check the set does not hold.
	for _, id := range rc.Drops {
		delete(defects, id)
	}
	{{ renderExpr (external $.Prove "All") }}(t, s.Checks, defects.Answering(doors))
}

// {{ suite_greenName .IfaceName }} runs every check — the generated ones and any you
// wrote — against an implementation that is CORRECT but different, and
// fails if a check rejects it.
//
//	func TestAnotherPolicyIsAllowed(t *testing.T) {
//		{{ suite_greenName .IfaceName }}(t, {{ renderExpr (external $.Vocab "Subject") }}[{{ suite_subjectType $c }}]{
//			Name: "evicts the newest", New: newNewestFirst,
//		})
//	}
//
// {{ suite_proveName .IfaceName }} measures whether these checks can fire. This measures
// whether they fire SELECTIVELY. Nothing else here can tell a check that
// is right from one that is too strong: a check forbidding something the
// declaration permits looks exactly like a suite working, until somebody
// writes a legal implementation and it fails.
//
// The control is a real alternative, not a broken one — a different
// eviction victim, a delivery that duplicates where the contract allows
// it, a lazier evaluation behind the same boundary. Where a check
// genuinely cannot apply to your control, put its ID in the subject's
// Excused map: an excused check is skipped by name, because it yields no
// evidence either way.
//
// Same arguments as {{ suite_runName .IfaceName }}, so the control meets the checks
// the run does — including the ones you wrote, which no caller can bind
// for themselves.
func {{ suite_greenName .IfaceName }}{{ renderTypeParams .TypeParams }}(
	t *{{ renderExpr (external "testing" "T") }},
	control {{ renderExpr (external $.Vocab "Subject") }}[{{ suite_subjectType $c }}],
	opts ...{{ suite_runOptName .IfaceName }}{{ .TypeArgs }},
) {
	t.Helper()
	var rc {{ suite_runConfigName .Token }}{{ .TypeArgs }}
	for _, o := range opts {
		o.applyTo(&rc)
	}
	{{ suite_fixtureIdent }} := {{ suite_newFixtureName .Token }}{{ .TypeArgs }}({{ if .Pools }}rc.cfg{{ end }})
	for _, row := range rc.rows {
		rc.AddCheck(row.bind({{ suite_fixtureIdent }}))
	}
	rc.Fail(t, "{{ suite_greenName .IfaceName }}")
	s := {{ suite_suiteName .Token }}{{ .TypeArgs }}(
		{{- if .DrawsFixture }}{{ suite_fixtureIdent }}{{ end }}
		{{- if and .DrawsFixture .SeedsCorpus }}, {{ end }}
		{{- if .SeedsCorpus }}{{ suite_corpusName .Token }}({{ if .Pools }}rc.cfg{{ end }}){{ end -}}
	).With(rc.Extra...).Without(rc.Drops...)
	// The doors the run answers, so a control is refused for being wrong
	// rather than for being unwired — a wiring red recorded as "the suite
	// rejected correct code" would poison the measurement it exists for.
	for door, answer := range {{ renderExpr (external $.Vocab "Doors") }}(rc.Subjects...) {
		if control.Provides == nil {
			control.Provides = map[{{ renderExpr (external $.Vocab "Capability") }}]any{}
		}
		if _, answered := control.Provides[door]; !answered {
			control.Provides[door] = answer
		}
	}
	{{ renderExpr (external $.Prove "Green") }}(t, s.Checks, control)
}
{{- end -}}
