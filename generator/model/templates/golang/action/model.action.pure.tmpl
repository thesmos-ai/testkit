{{- /*
A pure call takes no context by shape; both sides answer and the answers must
agree.
*/ -}}
{{- define "model.action.pure" -}}
{{ renderExpr .Ctor }}({{ printf "%q" .Method }},
				func(s {{ renderType .Iface }}) {{ renderType .Value }} {
					return s.{{ .Method }}({{ range $i, $arg := .Args }}{{ if $i }}, {{ end }}fx.{{ $arg.Field }}(){{ end }})
				})
{{- end -}}
