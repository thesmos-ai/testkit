type {{ lower $b.IfaceName }}SatSpill{{ .Method }} struct{ {{ renderType $b.IfaceRef }} }

func (m {{ lower $b.IfaceName }}SatSpill{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ({{ renderType .Out }}, error) {
	out, err := m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }})
