{{- /*
The saturation prover: binding a law is necessary, this is what makes it
sufficient. Per bound law, a defect is worn on each method the law's
closures reach, and at least one worn run must fail naming the law's own
identifier — with the clean factory standing as reference, so the twin
floor has real teeth against every mutant.
*/ -}}
{{- define "model.saturation" -}}
{{- if and .SatLaws .LegLaws }}
{{ $b := . }}
// {{ .IfaceName }}SatWear is one wearable defect: a kind, and the wrap that
// dresses a subject in it.
type {{ lower .IfaceName }}SatWear struct {
	kind string
	wrap func(fx {{ .IfaceName }}Fixture, s {{ renderType .IfaceRef }}) {{ renderType .IfaceRef }}
}

{{- if .SatMutants }}
//nolint:gochecknoglobals // the prover's wardrobe, read-only after init.
var {{ lower .IfaceName }}SatWears = map[string][]{{ lower .IfaceName }}SatWear{}

//nolint:gochecknoinits // the wardrobe fills once, keyed by method.
func init() { //nolint:staticcheck // an empty wardrobe leaves dress unused by design.
	dress := func(method, kind string, wrap func(fx {{ .IfaceName }}Fixture, s {{ renderType .IfaceRef }}) {{ renderType .IfaceRef }}) {
		{{ lower .IfaceName }}SatWears[method] = append({{ lower .IfaceName }}SatWears[method],
			{{ lower .IfaceName }}SatWear{kind: kind, wrap: wrap})
	}
{{- range $m := .SatMutants }}
{{- if eq .Kind "inert" }}
	dress({{ printf "%q" .Method }}, "inert", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return {{ lower $b.IfaceName }}SatInert{{ .Method }}{s}
	})
{{- else if eq .Kind "flap" }}
	dress({{ printf "%q" .Method }}, "flap", func(fx {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatFlap{{ .Method }}{ {{ $b.IfaceName }}: s, a: fx.{{ $b.Values.Field }}(), b: fx.{{ $b.Values.OtherField }}() }
	})
{{- else if eq .Kind "wane" }}
	dress({{ printf "%q" .Method }}, "wane", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatWane{{ .Method }}{ {{ $b.IfaceName }}: s }
	})
{{- else if eq .Kind "wax" }}
	dress({{ printf "%q" .Method }}, "wax", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatWax{{ .Method }}{ {{ $b.IfaceName }}: s }
	})
{{- else if eq .Kind "sputter" }}
	dress({{ printf "%q" .Method }}, "sputter", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatSputter{{ .Method }}{ {{ $b.IfaceName }}: s }
	})
{{- else if or (eq .Kind "fadeseq") (eq .Kind "dupseq") (and (eq .Kind "flood") .Seq) }}
	dress({{ printf "%q" .Method }}, {{ printf "%q" .Kind }}, func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return {{ lower $b.IfaceName }}Sat{{ .Kind }}{{ .Method }}{s}
	})
{{- else if eq .Kind "jumble" }}
	dress({{ printf "%q" .Method }}, "jumble", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return {{ lower $b.IfaceName }}SatJumble{{ .Method }}{s}
	})
{{- else if eq .Kind "dupdrain" }}
	dress({{ printf "%q" .Method }}, "dupdrain", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return {{ lower $b.IfaceName }}SatDupdrain{{ .Method }}{s}
	})
{{- else if eq .Kind "flood" }}
	dress({{ printf "%q" .Method }}, "flood", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return {{ lower $b.IfaceName }}SatFlood{{ .Method }}{s}
	})
{{- else if eq .Kind "regress" }}
	dress({{ printf "%q" .Method }}, "regress", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatRegress{{ .Method }}{ {{ $b.IfaceName }}: s }
	})
{{- else if eq .Kind "passthrough" }}
	dress({{ printf "%q" .Method }}, "passthrough", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return {{ lower $b.IfaceName }}SatPassthrough{{ .Method }}{s}
	})
{{- else if eq .Kind "stick" }}
	dress({{ printf "%q" .Method }}, "stick", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatStick{{ .Method }}{ {{ $b.IfaceName }}: s }
	})
{{- else if eq .Kind "spill" }}
	dress({{ printf "%q" .Method }}, "spill", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return {{ lower $b.IfaceName }}SatSpill{{ .Method }}{s}
	})
{{- else if eq .Kind "latch" }}
	dress({{ printf "%q" .Method }}, "latch", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatLatch{{ .Method }}{ {{ $b.IfaceName }}: s }
	})
{{- else if eq .Kind "greedy" }}
	dress({{ printf "%q" .Method }}, "greedy", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return {{ lower $b.IfaceName }}SatGreedy{{ .Method }}{s}
	})
{{- else if eq .Kind "flicker" }}
	dress({{ printf "%q" .Method }}, "flicker", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatFlicker{{ .Method }}{ {{ $b.IfaceName }}: s }
	})
{{- else if eq .Kind "overshoot" }}
	dress({{ printf "%q" .Method }}, "overshoot", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return {{ lower $b.IfaceName }}SatOvershoot{{ .Method }}{s}
	})
{{- else if eq .Kind "fade" }}
	dress({{ printf "%q" .Method }}, "fade", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatFade{{ .Method }}{ {{ $b.IfaceName }}: s }
	})
{{- else }}
	dress({{ printf "%q" .Method }}, "echo", func(_ {{ $b.IfaceName }}Fixture, s {{ renderType $b.IfaceRef }}) {{ renderType $b.IfaceRef }} {
		return &{{ lower $b.IfaceName }}SatEcho{{ .Method }}{ {{ $b.IfaceName }}: s }
	})
{{- end }}
{{- end }}
}
{{- end }}

// {{ lower .IfaceName }}SatOnly narrows the bound set to one law.
//
// The prover's instrument, not a knob. A conformance run asserts every
// law the classifications earned; dropping all but one is only ever
// right when the question is "can THIS law fail", which is the one
// question asked here.
func {{ lower .IfaceName }}SatOnly(laws []{{ renderExpr (external .LawPath "Law") }}[{{ .SubjectSpelling }}], id string) ({{ renderExpr (external .LawPath "Law") }}[{{ .SubjectSpelling }}], bool) {
	for _, l := range laws {
		if l.ID() == id {
			return l, true
		}
	}
	return nil, false
}

// {{ .IfaceName }}ModelSaturation proves the bound laws can fail.
//
// Binding a law is necessary; this is what makes it sufficient. Per law,
// a defect is worn on each method the law's closures reach — zeros, the
// fixture pair alternated, a waning count — and at least one worn run
// must fail naming the law's own identifier. A law every defect survives
// is bound but unsaturatable, and fails here by name.
//
// It takes YOUR implementation, because that is the only correct subject
// there is to break: a defect worn over the generated double proves
// nothing, since the double answers zeros before anything is worn on it.
//
//	func TestMyLawsCanFail(t *testing.T) {
//		{{ .IfaceName }}ModelSaturation(t, func() {{ .SubjectSpelling }} { return NewMine() })
//	}
func {{ .IfaceName }}ModelSaturation(t *{{ renderExpr (external "testing" "T") }}, factory func() {{ .SubjectSpelling }}) {
	t.Helper()
	fx := {{ .FixtureCtor }}()
	_ = fx
{{- range .SatLaws }}
	t.Run({{ printf "%q" .ID }}, func(t *{{ renderExpr (external "testing" "T") }}) {
{{- if .Clocked }}
		t.Skip("a clocked law's factory builds its own subjects on the run's clock; a worn defect never reaches it")
{{- else if .Unwearable }}
		t.Skip("the law closes over no method a defect can wear — its closures are doors and traces")
{{- else if .Unreached }}
		// A wear of this law's own class exists and never reaches it. The
		// reason is a fact about the mechanism rather than about the class, so
		// it is registered beside the wardrobe rather than inferred here.
		t.Skip("no wear reaches {{ .ID }}: {{ .Unreached }}")
{{- else if not .Proves }}
		// Not a survival, and the distinction is the whole point of the
		// defect-class axis. This law's name promises a defect the wardrobe
		// cannot produce — every dressing here acts on what a call answers,
		// and a partial effect or a retained resource is not an answer. The
		// gap is in the wardrobe, and conformance/gate.UnprovableLaws is where
		// it is argued and counted.
		t.Skip("no wear produces the defect {{ .ID }} is named for; the wardrobe owes it one")
{{- else }}
		one, bound := {{ lower $b.IfaceName }}SatOnly({{ $b.LawsFuncName }}({{ template "model.satlawargs" $b }}), {{ printf "%q" .ID }})
		if !bound {
			t.Skip("the law was selected and this build did not register it; the header says what it is waiting on")
		}
		proving := map[string]bool{ {{ range $i, $k := .Proves }}{{ if $i }}, {{ end }}{{ printf "%q" $k }}: true{{ end }} }
		killed := func() bool {
			for _, method := range []string{ {{ range $i, $m := .Methods }}{{ if $i }}, {{ end }}{{ printf "%q" $m }}{{ end }} } {
				for _, wear := range {{ lower $b.IfaceName }}SatWears[method] {
				if !proving[wear.kind] {
					continue
				}
				// Two references per defect. Silencing the differential leaves
				// the law as the only witness, but not every action reports
				// through it: a shape whose action fails structurally still
				// ends the iteration, and a reference wearing the same defect
				// behaves the same way the subject does, so nothing diverges
				// and the law is reached. A law that *is* the comparison needs
				// the opposite — with both sides worn it has nothing to
				// disagree with — so the clean reference runs too and either
				// kill counts. The corpus measured both: dropping either one
				// loses laws that only the other can saturate.
				for _, blind := range []bool{true, false} {
					surrogate := "{{ $b.IfaceName }}Sat_{{ .ID }}_" + method + "_" + wear.kind
					if blind {
						surrogate += "_blind"
					}
					t.Cleanup(func() {
						_ = {{ renderExpr (external "os" "RemoveAll") }}({{ renderExpr (external "path/filepath" "Join") }}("testdata", "rapid", surrogate))
						_ = {{ renderExpr (external "os" "Remove") }}({{ renderExpr (external "path/filepath" "Join") }}(
							{{ renderExpr (external $b.ModelPkg "ResolveArtifactDir") }}(""), "failure-"+surrogate+".json"))
					})
					reference := factory
					if blind {
						reference = func() {{ $b.SubjectSpelling }} { return wear.wrap(fx, factory()) }
					}
					f := {{ renderExpr (external $b.RootPkg "NewFailableTB") }}().WithName(surrogate)
					// One law and no differential: with siblings registered the
					// first to catch a defect ends the iteration, and every
					// other law bound on the same methods reads as
					// unsaturatable. Isolating it is what leaves this law as
					// the only witness.
					{{ renderExpr (external $b.ModelPkg "Assert") }}(f,
						func() {{ $b.SubjectSpelling }} { return wear.wrap(fx, factory()) },
						{{ renderExpr (external $b.ModelPkg "WithReference") }}(reference),
						{{ renderExpr (external $b.ModelPkg "WithActions") }}({{ $b.ActionsFuncName }}({{ template "model.satargs" $b }})...),
						{{ renderExpr (external $b.ModelPkg "WithLawsOnly") }}[{{ $b.SubjectSpelling }}](true),
						{{ renderExpr (external $b.ModelPkg "WithLaw") }}(one))
					// The reporter's own rendering, not the bare identifier.
					// rapid echoes the TB's name into its final message and the
					// surrogate above is named for this law, so matching the
					// identifier alone matched the name — the criterion reduced
					// to f.Failed() and every defect "killed" every law. The
					// verdict's format carries the identifier where no name can:
					// after the kind, which is the one place only the reporter
					// writes. The suffix rather than the whole prefix because a
					// REQ-tagged law renders "[REQ-1 invariant]".
					if f.Failed() && ({{ if .AcceptSemantic }}{{ renderExpr (external "strings" "Contains") }}(f.Msg(), "semantic]") || {{ end }}{{ renderExpr (external "strings" "Contains") }}(f.Msg(), {{ printf "%q" (printf "invariant] %s" .ID) }})) {
						return true
					}
					}
				}
			}
			return false
		}()
		if !killed {
			t.Errorf("{{ .ID }} survived every defect worn on its own methods — bound but unsaturatable")
		}
		// Not yet narrowed to this law's own defect class. The wears whose
		// class its name claims are
		// {{ range $i, $k := .Proves }}{{ if $i }}, {{ end }}{{ $k }}{{ end }} — requiring the kill to come from one
		// of those reddens 23 laws across the corpus, and the measurement says
		// roughly a third are weak laws and the rest are wrong classes. That
		// triage is 1.10b. What ships here is the skip above, which is the
		// half the measurement settled.
{{- end }}
	})
{{- end }}
}
{{- range .SatMutants }}
{{- if eq .Kind "inert" }}

// {{ lower $b.IfaceName }}SatInert{{ .Method }} answers zeros where {{ .Method }} should act.
type {{ lower $b.IfaceName }}SatInert{{ .Method }} struct{ {{ renderType $b.IfaceRef }} }

{{ if .Seq -}}
// A stream's zero value is a nil iterator, and ranging over one panics before
// the law is asked — so answering nothing means an empty sequence, not none.
func (m {{ lower $b.IfaceName }}SatInert{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) {{ index .Returns 0 | renderType }} {
	return {{ renderExpr (external $b.RootPkg .SeqHelper) }}(m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }}))
}
{{- else -}}
func ({{ lower $b.IfaceName }}SatInert{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}_ {{ renderType $p }}{{ end }}){{ if .Returns }} ({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}z{{ $i }} {{ renderType $r }}{{ end }}){{ end }} {
	return
}
{{- end }}
{{- else if eq .Kind "flap" }}

// {{ lower $b.IfaceName }}SatFlap{{ .Method }} alternates the fixture pair where
// {{ .Method }} should answer the store.
type {{ lower $b.IfaceName }}SatFlap{{ .Method }} struct {
	{{ renderType $b.IfaceRef }}
	flip {{ renderExpr (external "sync/atomic" "Int64") }}
	a, b {{ renderType .Out }}
}

func (m *{{ lower $b.IfaceName }}SatFlap{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}_ {{ renderType $p }}{{ end }}) ({{ renderType .Out }}, error) {
	if m.flip.Add(1)%2 == 0 {
		return m.a, nil
	}
	return m.b, nil
}
{{- else if eq .Kind "wane" }}

// {{ lower $b.IfaceName }}SatWane{{ .Method }} answers a strictly waning count
// where {{ .Method }} should observe.
type {{ lower $b.IfaceName }}SatWane{{ .Method }} struct {
	{{ renderType $b.IfaceRef }}
	flip {{ renderExpr (external "sync/atomic" "Int64") }}
}

func (m *{{ lower $b.IfaceName }}SatWane{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}_ {{ renderType $p }}{{ end }}) ({{ renderType .Out }}, error) {
	return {{ renderType .Out }}(1000 - m.flip.Add(1)), nil
}
{{- else if eq .Kind "wax" }}

// {{ lower $b.IfaceName }}SatWax{{ .Method }} answers a count that only grows
// where {{ .Method }} should return to rest.
type {{ lower $b.IfaceName }}SatWax{{ .Method }} struct {
	{{ renderType $b.IfaceRef }}
	flip {{ renderExpr (external "sync/atomic" "Int64") }}
}

func (m *{{ lower $b.IfaceName }}SatWax{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}_ {{ renderType $p }}{{ end }}) ({{ renderType .Out }}, error) {
	return {{ renderType .Out }}(m.flip.Add(1)), nil
}
{{- else if eq .Kind "sputter" }}

// {{ lower $b.IfaceName }}SatSputter{{ .Method }} alternates a minted refusal
// with the real answer where {{ .Method }} should be steady.
type {{ lower $b.IfaceName }}SatSputter{{ .Method }} struct {
	{{ renderType $b.IfaceRef }}
	flip {{ renderExpr (external "sync/atomic" "Int64") }}
}

func (m *{{ lower $b.IfaceName }}SatSputter{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}){{ if .Returns }} ({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}z{{ $i }} {{ renderType $r }}{{ end }}){{ end }} {
	if m.flip.Add(1)%2 == 1 {
		z{{ .Last }} = {{ renderExpr (external "errors" "New") }}("{{ $b.MissPrefix }}: saturation sputtered a refusal")
		return
	}
	return m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }})
}
{{- else if or (eq .Kind "fadeseq") (eq .Kind "dupseq") (and (eq .Kind "flood") .Seq) }}

// {{ lower $b.IfaceName }}Sat{{ .Kind }}{{ .Method }} answers a drain the
// claims about {{ .Method }}'s stream say is impossible — reversed and short
// one, with every element repeated, or past any limit a test can wait for.
//
// The slice-returning shape has had these defects all along. A method that
// streams had only the zero and the flicker, and a claim about order or
// duplicates survives both: an empty drain is ordered and holds no repeats.
type {{ lower $b.IfaceName }}Sat{{ .Kind }}{{ .Method }} struct{ {{ renderType $b.IfaceRef }} }

func (m {{ lower $b.IfaceName }}Sat{{ .Kind }}{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) {{ index .Returns 0 | renderType }} {
	return {{ renderExpr (external $b.RootPkg .SeqDefect) }}(m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }}))
}
{{- else if eq .Kind "jumble" }}

// {{ lower $b.IfaceName }}SatJumble{{ .Method }} answers every drain
// reversed, where {{ .Method }}'s order claim says one order holds.
//
// Every drain, not every second one. A claim read off a single drain is
// answered by whichever call the law makes, and the prover isolates one law
// at a time — so an alternating defect lands entirely on the parity the law
// never sees, and survives a wear built to break it.
type {{ lower $b.IfaceName }}SatJumble{{ .Method }} struct{ {{ renderType $b.IfaceRef }} }

func (m {{ lower $b.IfaceName }}SatJumble{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ([]{{ renderType .Out }}, error) {
	out, err := m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }})
	if err != nil {
		return out, err
	}
	jumbled := {{ renderExpr (external "slices" "Clone") }}(out)
	{{ renderExpr (external "slices" "Reverse") }}(jumbled)
	return jumbled, nil
}
{{- else if eq .Kind "dupdrain" }}

// {{ lower $b.IfaceName }}SatDupdrain{{ .Method }} answers every drain with
// its first element repeated at the end, where {{ .Method }}'s claim says no
// element appears twice.
//
// Appended rather than doubled in place: a drain whose every element repeats
// is also out of order under most comparisons, and a defect that trips two
// claims cannot show which one it belongs to.
type {{ lower $b.IfaceName }}SatDupdrain{{ .Method }} struct{ {{ renderType $b.IfaceRef }} }

func (m {{ lower $b.IfaceName }}SatDupdrain{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ([]{{ renderType .Out }}, error) {
	out, err := m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }})
	if err != nil || len(out) == 0 {
		return out, err
	}
	return append({{ renderExpr (external "slices" "Clone") }}(out), out[0]), nil
}
{{- else if eq .Kind "stick" }}

// {{ lower $b.IfaceName }}SatStick{{ .Method }} lets {{ .Method }} work once
// and refuses forever after — the close that is not idempotent.
//
// sputter cannot express this. An idempotence law calls twice and discards
// the first answer, so an alternating refusal is absorbed by the very call
// the law is not reading, on every iteration. What the claim forbids is the
// *second* call failing, and only a defect that arrives after the first can
// say so.
type {{ lower $b.IfaceName }}SatStick{{ .Method }} struct {
	{{ renderType $b.IfaceRef }}
	used {{ renderExpr (external "sync/atomic" "Bool") }}
}

func (m *{{ lower $b.IfaceName }}SatStick{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) error {
	if m.used.Swap(true) {
		return {{ renderExpr (external "errors" "New") }}("{{ $b.MissPrefix }}: saturation stuck {{ .Method }} after its first call")
	}
	return m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }})
}
{{- else if eq .Kind "greedy" }}

// {{ lower $b.IfaceName }}SatGreedy{{ .Method }} runs the caller's own
// computation one extra time before doing the work.
//
// A method taking a computation promises something about how often it runs
// it — deduplicated, memoised, once. No other wear can touch that: every one
// of them changes what the method *answers*, and a coalescing claim counts
// what it *called*. The counter such a law reads lives inside the closure the
// law passed in, so the only way to move it is to invoke that closure.
type {{ lower $b.IfaceName }}SatGreedy{{ .Method }} struct{ {{ renderType $b.IfaceRef }} }

func (m {{ lower $b.IfaceName }}SatGreedy{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}{{ renderType $r }}{{ end }}) {
	_ = p{{ .Member }}()
	return m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }})
}
{{- else if eq .Kind "latch" }}

// {{ lower $b.IfaceName }}SatLatch{{ .Method }} lets the first
// {{ .Method }} through and quietly drops every one after it.
//
// The order-sensitive fold, which is the one defect a commutativity claim can
// see. That law builds both its instances from the same worn factory and
// applies the same values in opposite orders, so every other wear reaches
// both sides identically and the two observations agree however wrong they
// are. A fold that keeps only what it saw first keeps a different thing on
// each side.
//
// Silent, where stick refuses: a claim about what an operation *did* cannot
// be broken by one that says it failed.
type {{ lower $b.IfaceName }}SatLatch{{ .Method }} struct {
	{{ renderType $b.IfaceRef }}
	used {{ renderExpr (external "sync/atomic" "Bool") }}
}

func (m *{{ lower $b.IfaceName }}SatLatch{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) error {
