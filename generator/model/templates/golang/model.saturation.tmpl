{{- else }}

// {{ lower $b.IfaceName }}SatEcho{{ .Method }} answers the first page forever,
// with more always promised — the walk that never advances.
type {{ lower $b.IfaceName }}SatEcho{{ .Method }} struct {
	{{ renderType $b.IfaceRef }}
	mu   {{ renderExpr (external "sync" "Mutex") }}
