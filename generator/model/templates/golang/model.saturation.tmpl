type {{ lower $b.IfaceName }}SatRegress{{ .Method }} struct {
	{{ renderType $b.IfaceRef }}
	mu   {{ renderExpr (external "sync" "Mutex") }}
	held bool
	prev {{ renderType .Out }}
}

func (m *{{ lower $b.IfaceName }}SatRegress{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ({{ renderType .Out }}, error) {
	out, err := m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }})
