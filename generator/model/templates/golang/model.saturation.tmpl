func (m *{{ lower $b.IfaceName }}SatFlicker{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}z{{ $i }} {{ renderType $r }}{{ end }}) {
