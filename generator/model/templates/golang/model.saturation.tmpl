type {{ lower $b.IfaceName }}SatFlood{{ .Method }} struct{ {{ renderType $b.IfaceRef }} }

func (m {{ lower $b.IfaceName }}SatFlood{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ([]{{ renderType .Out }}, error) {
	out, err := m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }})
