func (m *{{ lower $b.IfaceName }}SatEcho{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ({{ index .Returns 0 | renderType }}, {{ index .Returns 1 | renderType }}, {{ index .Returns 2 | renderType }}, error) {
