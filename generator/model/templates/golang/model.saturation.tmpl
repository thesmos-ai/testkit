type {{ lower $b.IfaceName }}SatFade{{ .Method }} struct {
	{{ renderType $b.IfaceRef }}
	flip {{ renderExpr (external "sync/atomic" "Int64") }}
}

func (m *{{ lower $b.IfaceName }}SatFade{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ([]{{ renderType .Out }}, error) {
	out, err := m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }})
	if err != nil || m.flip.Add(1)%2 == 1 || len(out) == 0 {
