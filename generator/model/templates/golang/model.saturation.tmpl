type {{ lower $b.IfaceName }}SatPassthrough{{ .Method }} struct{ {{ renderType $b.IfaceRef }} }

func (m {{ lower $b.IfaceName }}SatPassthrough{{ .Method }}) {{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }} {{ renderType $p }}{{ end }}) ({{ renderType .Out }}, error) {
	if _, err := m.{{ $b.IfaceName }}.{{ .Method }}({{ range $i, $p := .Params }}{{ if $i }}, {{ end }}p{{ $i }}{{ end }}); err != nil {
