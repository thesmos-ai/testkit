{{- /*
The whole model tier for one interface: the contract option, the property, the
derived reference, and its adapter. One file so deleting the directive deletes
the tier — and the engine dependency with it.
*/ -}}
{{- define "model.bindings" -}}
{{ $b := . }}
// {{ .OptionName }} runs random sequences of {{ .IfaceName }}'s methods against every
// subject and a known-good in-memory reference side by side, comparing after
// every call. Pass it to {{ .EntryName }}; it reports under
// "{{ .TierPath }}", and {{ .IfaceName }}Without("{{ .TierPath }}") declines it.
//
{{- if .Reference.Supplied }}
//	Reference: supplied through //testkit:model ref=
{{- else if .Reference.Twin }}
//	Reference: the subject's own factory — {{ .Reference.TwinWhy }},
//	           so a second instance driven identically stands in: twins must
//	           agree, which catches nondeterminism and hidden shared state but
//	           not a subject wrong the same way twice; ref= raises the floor
{{- else if .Reference.IsContract }}
//	Reference: derived — the {{ .Reference.StoreType }} oracle, which is the
//	           {{ .Reference.ContractName }} contract's own semantics; {{ .IfaceName }}ModelReference replaces it
{{- else if .Reference.Collects }}
//	Reference: derived — an append-and-drain collection over the
//	           {{ .Values.Field }} fixture pair; {{ .IfaceName }}ModelReference replaces it
{{- else if .Reference.Keyed }}
//	Reference: derived — a keyed store over the {{ .Keys.Field }} and
//	           {{ .Values.Field }} fixture pairs; {{ .IfaceName }}ModelReference replaces it
{{- else }}
//	Reference: derived — a {{ if .Reference.Pins }}resolution-pinning{{ else }}keyed{{ end }} map over the {{ .Values.Field }} fixture pair,
//	           keyed on {{ .Reference.KeyField }}; {{ .IfaceName }}ModelReference replaces it
{{- end }}
//	Sequences: {{ range $i, $a := .Actions }}{{ if $i }}, {{ end }}{{ $a.Method }} ({{ $a.Shape }}){{ end }}
{{- if .Witnesses }}
//	Witnesses: the property runs at {{ renderType .IfaceRef }} — the types
//	           the source's witness= names, one per type parameter
{{- end }}
{{- if .Session }}
//	Sessions:  per-client laws read {{ .Session.VersionField }} off {{ .Session.Reader }}'s value; the
//	           concurrent leg interleaves real clients over a stepless model —
//	           a store-assigned stamp defeats value equality, so the laws carry it
{{- end }}
{{- if .Publisher }}
//	Drain:     derived — a non-blocking sweep asserting fan-out synchronous
//	           with Publish; an async subject supplies {{ .IfaceName }}ModelDrain or this
//	           floor reads its in-flight deliveries as loss
{{- end }}
{{- if .UsesValues }}
{{- if .Values.GenFunc }}
//	Values:    the fixture pair blended with {{ .Values.GenFunc }}'s draws — the gen= supply
{{- else if .Values.Wide }}
//	Values:    the fixture pair blended with arbitrary draws{{ if .Values.Pin }}, each keyed
//	           from the pool{{ end }}; {{ .IfaceName }}ModelValues replaces the pool
{{- else }}
//	Values:    the fixture pair — {{ .Values.WhyNarrow }};
//	           {{ .IfaceName }}ModelValues is the door to a wider pool
{{- end }}
{{- end }}
{{- if eq .ConcFamily "kv" }}
//	Concurrent: {{ .ConcWriter.Method }} and {{ .ConcReader.Method }} interleave across four workers,
//	           Porcupine-checked against the keyed-store model per key
{{- else if eq .ConcFamily "session" }}
//	Concurrent: {{ .ConcWriter.Method }} and {{ .ConcReader.Method }} interleave across four workers;
//	           the per-client laws read the multi-client trace — stepless,
//	           because a store-assigned {{ .Session.VersionField }} defeats value equality
{{- else if eq .ConcFamily "lease" }}
//	Concurrent: {{ .ConcAcquire.Method }} and {{ .ConcRelease.Method }} interleave across four workers,
//	           Porcupine-checked against the lease-table model per key
{{- else if eq .ConcFamily "cas" }}
//	Concurrent: {{ .ConcWriter.Method }} and {{ .ConcReader.Method }} interleave across four workers,
//	           Porcupine-checked against the versioned-cell model in the
//	           oracle's own dialect
{{- else if eq .ConcFamily "append" }}
//	Concurrent: {{ .ConcWriter.Method }} interleaves across four workers,
//	           Porcupine-checked against the shared append-log model — the
//	           offsets of one linearizable order
{{- end }}
{{- with .Laws }}
//	Laws:      {{ range $i, $l := . }}{{ if $i }}, {{ end }}{{ $l.ID }}{{ if $l.Clocked }} (clocked){{ end }}{{ if $l.Supplied }} (supplied: {{ range $j, $s := $l.Supplied }}{{ if $j }}, {{ end }}{{ $s }}{{ end }}){{ end }}{{ if $l.Unarmed }} (unarmed: {{ range $j, $u := $l.Unarmed }}{{ if $j }}, {{ end }}{{ $u }}{{ end }}){{ end }}{{ end }}
{{- end }}
{{- if .UsesClock }}
//	Clock:     the (clocked) laws arm only under {{ .IfaceName }}ModelClocked,
//	           whose factory builds the subject on the run's own test clock —
//	           advancing a clock the subject does not read fails every
//	           correct implementation
{{- end }}
{{- with .Skipped }}
//	Not driven:
{{- range . }}
//	           {{ .Method }} — {{ .Reason }}
{{- end }}
{{- end }}
{{- with .Unbound }}
//	Not bound:
{{- range . }}
//	           {{ .Method }} — {{ .Reason }}
{{- end }}
{{- end }}
func {{ .OptionName }}(opts ...{{ .OptionTypeName }}) {{ .IfaceName }}Option{{ template "model.witnessuse" . }} {
	return func(c *{{ lower .IfaceName }}Config{{ template "model.witnessuse" . }}) {
		c.extensions = append(c.extensions, {{ lower .IfaceName }}ContractExtension{{ template "model.witnessuse" . }}{
			name: "{{ .TierPath }}",
			run: func(t *{{ renderExpr (external "testing" "T") }}, _ string, factory func() {{ renderType .IfaceRef }}, _ *{{ lower .IfaceName }}Config{{ template "model.witnessuse" . }}) {
				{{ renderExpr (external .ModelPkg "Check") }}(t, {{ .PropertyName }}(factory, opts...))
			},
		})
{{- if .Concurrent }}
		c.extensions = append(c.extensions, {{ lower .IfaceName }}ContractExtension{{ template "model.witnessuse" . }}{
			name: "{{ .TierName }}/concurrent",
			run: func(t *{{ renderExpr (external "testing" "T") }}, _ string, factory func() {{ renderType .IfaceRef }}, _ *{{ lower .IfaceName }}Config{{ template "model.witnessuse" . }}) {
				{{ .IfaceName }}ModelConcurrent(t, factory, opts...)
			},
		})
{{- end }}
	}
}

// {{ .PropertyName }} builds the property the option runs — exported because a
// bespoke harness composes from here: model.Check for a test, model.MakeFuzz
// for a coverage-guided fuzz target, both over this one derivation.
func {{ .PropertyName }}(factory func() {{ renderType .IfaceRef }}, opts ...{{ .OptionTypeName }}) func(*{{ renderExpr (external .ModelPkg "T") }}) {
	cfg := new{{ .IfaceName }}ModelConfig(opts...)
{{- if .NeedsFixture }}
	fx := {{ .FixtureCtor }}{{ template "model.witnessuse" . }}()
{{- end }}
{{- template "model.pools" . }}
{{- template "model.lawpools" . }}
{{- if .UsesClock }}
	// One deterministic clock per property: the clocked factory builds every
	// subject on it, and the aging laws advance it. A fixed origin, because a
	// wall reading would make the choice stream unreplayable.
	var clk *{{ renderExpr (external .ClockPkg "TestClock") }}
	if cfg.clocked != nil {
		clk = {{ renderExpr (external .ClockPkg "NewTestClock") }}({{ renderExpr (external "time" "Unix") }}(0, 0))
		clocked := cfg.clocked
		factory = func() {{ renderType .IfaceRef }} { return clocked(clk) }
	}
{{- end }}
	reference := cfg.reference
	if reference == nil {
{{- if .Reference.Supplied }}
		reference = {{ renderExpr .Reference.SuppliedCtor }}
{{- else if .Reference.Twin }}
		reference = factory
{{- else }}
		reference = {{ .Reference.CtorName }}
{{- end }}
	}
{{- if and .UsesClock (not .Reference.Twin) }}
	if cfg.reference == nil && clk != nil {
		// Under the clock, the derived oracle lies: every mirrored write
		// ages on the subject and never on a store that cannot read time.
		// Twins on one clock age together, so the clocked run rides them.
		reference = factory
	}
{{- end }}
{{- if .Laws }}
	// The laws the classifications earned, each reporting under its AUTO-
	// identifier when it fails. Observational: a law never mutates, so running
	// them inside the sequences is safe for every step that follows.
{{- if .Publisher }}
	// The supplied drain outranks the derived sweep: the sweep is the
	// synchronous floor, and an asynchronous publisher knows better.
	drainSub := cfg.drain
	if drainSub == nil {
		drainSub = {{ .Publisher.DrainName }}
	}
{{- end }}
{{- if .Coalesced }}
	// The coalescing law's own instrumentation: its compute increments this
	// under the lock, because a subject that fails to coalesce invokes it
	// concurrently.
	coalesceCalls := 0
	var coalesceMu {{ renderExpr (external "sync" "Mutex") }}
{{- end }}
{{- if .RecordsHistory }}
	// Every successful append the sequences drive lands here too, so the
	// no-drops law knows what was attempted; the runner clears it each
	// iteration.
	appendHist := {{ renderExpr (external .HistoryPkg "New") }}[string, {{ renderType .HistoryElem }}]()
{{- end }}
	laws := {{ renderExpr (external .ModelPkg "NewRegistry") }}[{{ renderType .IfaceRef }}]()
{{- range .Laws }}
{{- if not .Clocked }}
{{- if .Supplied }}
	if {{ range $i, $s := .Supplied }}{{ if $i }} && {{ end }}cfg.{{ $s }} != nil{{ end }} {
		laws.Add({{ render . }})
	} else {
		laws.Declined({{ printf "%q" .ID }},
			"{{ range $i, $s := .Supplied }}{{ if $i }} and {{ end }}{{ $b.IfaceName }}Model{{ title $s }}{{ end }}")
	}
{{- else }}
	laws.Add({{ render . }})
{{- end }}
{{- end }}
{{- end }}
{{- if .UsesClock }}
	if clk != nil {
{{- range .Laws }}
{{- if .Clocked }}
		laws.Add({{ render . }})
{{- end }}
{{- end }}
	} else {
		// The door the header names, said again where the run can hear it. A
		// clocked law without a clocked factory used to vanish: selected,
		// listed as bound, and never registered.
{{- range .Laws }}
{{- if .Clocked }}
		laws.Declined({{ printf "%q" .ID }}, "{{ $b.IfaceName }}ModelClocked")
{{- end }}
{{- end }}
	}
{{- end }}
{{- end }}
{{- if .SatLaws }}
	// The saturation prover's isolation: with siblings registered, the first
	// law to catch a defect ends the iteration and every other law bound on
	// the same methods reads as unsaturatable.
	if cfg.onlyLaw != "" {
		for _, l := range laws.Laws() {
			if l.ID() != cfg.onlyLaw {
				laws.SkipByID(l.ID())
			}
		}
	}
{{- end }}
	return {{ renderExpr (external .ModelPkg "Property") }}(factory,
		{{ renderExpr (external .ModelPkg "WithReference") }}(reference),
{{- if .Laws }}
		{{ renderExpr (external .ModelPkg "WithLaws") }}(laws),
{{- end }}
{{- if .SatLaws }}
		// Isolating one law is the prover asking whether that law can fail,
		// and the differential answers first for almost any defect — the
		// worn subject disagrees with the clean reference at step 0 and the
		// iteration ends before a law is consulted. Silencing it is what
		// leaves the law as the only witness. A conformance run isolates
		// nothing, so this is false there and the differential stays armed.
		{{ renderExpr (external .ModelPkg "WithLawsOnly") }}[{{ renderType .IfaceRef }}](cfg.onlyLaw != ""),
{{- end }}
{{- if .RecordsHistory }}
		{{ renderExpr (external .ModelPkg "WithHistoryReset") }}[{{ renderType .IfaceRef }}](appendHist.Reset),
{{- end }}
		{{ renderExpr (external .ModelPkg "WithActions") }}(
{{- range .Actions }}
			{{ render . }},
{{- end }}
		),
	)
}
// {{ .IfaceName }}ModelFuzz hands a subject's sequence space to the
// coverage-guided engine: the fuzzer's bytes replay as rapid's choice
// stream, so mutating them mutates the action ordering and every drawn
// input at once — and the engine's coverage feedback climbs the subject's
// own branches, which is what no fixed seed can do. Wire it from a fuzz
// target beside the subject:
//
//	func Fuzz{{ .IfaceName }}(f *testing.F) {
//		{{ .IfaceName }}ModelFuzz(f, func() {{ .IfaceName }} { return NewMine() })
//	}
func {{ .IfaceName }}ModelFuzz(f *{{ renderExpr (external "testing" "F") }}, factory func() {{ renderType .IfaceRef }}, opts ...{{ .OptionTypeName }}) {
	f.Add([]byte{})
	f.Fuzz({{ renderExpr (external .ModelPkg "MakeFuzz") }}({{ .PropertyName }}(factory, opts...)))
}
{{ if .Concurrent }}
// {{ .IfaceName }}ModelConcurrent runs the linearizability leg: four workers
{{- if eq .ConcFamily "kv" }}
// interleave {{ .ConcWriter.Method }} and {{ .ConcReader.Method }} over the shared pools, and
// Porcupine checks the recorded history against the keyed-store model, one
// key at a time. No reference runs here — linearizability is the oracle —
{{- else if eq .ConcFamily "session" }}
// interleave {{ .ConcWriter.Method }} and {{ .ConcReader.Method }} over the shared pools, and hold
// the recorded interleaving to the per-client session laws. No Porcupine
// model runs here — the subject assigns {{ .Session.VersionField }} on write, which no
// value-equality model predicts — so the trace-scanning laws are the check.
{{- else if eq .ConcFamily "lease" }}
// interleave {{ .ConcAcquire.Method }} and {{ .ConcRelease.Method }} over the shared keys, and
// Porcupine checks the recorded history against the lease-table model, one
// key at a time. No reference runs here — linearizability is the oracle —
{{- end }}
// and the laws stay with the sequential leg, whose step boundary they need.
// Exported for the same bespoke harnesses the property serves.
func {{ .IfaceName }}ModelConcurrent(t *{{ renderExpr (external "testing" "T") }}, factory func() {{ renderType .IfaceRef }}, opts ...{{ .OptionTypeName }}) {
{{- if .UsesValues }}
	cfg := new{{ .IfaceName }}ModelConfig(opts...)
{{- end }}
	fx := {{ .FixtureCtor }}{{ template "model.witnessuse" . }}()
{{- template "model.pools" . }}
	{{ renderExpr (external .ModelPkg "Assert") }}(t, factory,
{{- if eq .ConcFamily "kv" }}
		{{ renderExpr (external .ModelPkg "WithConcurrent") }}({{ renderExpr (external .ModelPkg "ConcurrentConfig") }}[{{ renderType .IfaceRef }}]{
			// The subject's own miss error is not knowable here; nil reads
			// any non-nil answer on an absent key as a miss. The op spellings
			// are the model's canonical vocabulary, not the method names —
			// the model switches on them, and an alias checks nothing.
			Model: {{ renderExpr (external .LinearizePkg "KV") }}[{{ renderType .Keys.Type }}, {{ renderType .Values.Type }}](nil),
			Actions: []{{ renderExpr (external .ModelPkg "ConcurrentAction") }}[{{ renderType .IfaceRef }}]{
				{{ renderExpr (external .LinearizePkg "ConcurrentWriter") }}({{ renderExpr (external .LinearizePkg "OpPut") }}, values,
					func({{ if .ConcWriter.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}, v {{ renderType .Values.Type }}) error {
						return s.{{ .ConcWriter.Method }}({{ if .ConcWriter.TakesCtx }}ctx, {{ end }}v)
					}, {{ .KeyOfName }}),
				{{ renderExpr (external .LinearizePkg "ConcurrentReader") }}({{ renderExpr (external .LinearizePkg "OpGet") }}, keys,
					func({{ if .ConcReader.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}, k {{ renderType .Keys.Type }}) ({{ renderType .Values.Type }}, error) {
						return s.{{ .ConcReader.Method }}({{ if .ConcReader.TakesCtx }}ctx, {{ end }}k)
					}),
			},
		}),
{{- else if eq .ConcFamily "session" }}
		{{ renderExpr (external .ModelPkg "WithConcurrent") }}({{ renderExpr (external .ModelPkg "ConcurrentConfig") }}[{{ renderType .IfaceRef }}]{
			// Stepless on purpose: the subject assigns {{ .Session.VersionField }} on write, and
			// no value-equality model survives a stamp it cannot predict. The
			// per-client laws over the recorded interleaving are the check.
			Actions: []{{ renderExpr (external .ModelPkg "ConcurrentAction") }}[{{ renderType .IfaceRef }}]{
{{- if eq .Session.Writer .ConcWriter.Method }}
				{{ renderExpr (external .LinearizePkg "ConcurrentAnsweringWriter") }}("{{ .ConcWriter.Method }}", values,
					func({{ if .ConcWriter.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}, v {{ renderType .Values.Type }}) ({{ renderType .Values.Type }}, error) {
						return s.{{ .ConcWriter.Method }}({{ if .ConcWriter.TakesCtx }}ctx, {{ end }}v)
					}, func(v {{ renderType .Values.Type }}) {{ renderType .Keys.Type }} { return v.{{ .Session.KeyField }} }),
{{- else }}
				{{ renderExpr (external .LinearizePkg "ConcurrentWriter") }}("{{ .ConcWriter.Method }}", values,
					func({{ if .ConcWriter.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}, v {{ renderType .Values.Type }}) error {
						return s.{{ .ConcWriter.Method }}({{ if .ConcWriter.TakesCtx }}ctx, {{ end }}v)
					}, func(v {{ renderType .Values.Type }}) {{ renderType .Keys.Type }} { return v.{{ .Session.KeyField }} }),
{{- end }}
				{{ renderExpr (external .LinearizePkg "ConcurrentReader") }}("{{ .ConcReader.Method }}", keys,
					func({{ if .ConcReader.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}, k {{ renderType .Keys.Type }}) ({{ renderType .Values.Type }}, error) {
						return s.{{ .ConcReader.Method }}({{ if .ConcReader.TakesCtx }}ctx, {{ end }}k)
					}),
			},
		}),
{{- range .Laws }}{{ if .Session }}
		{{ renderExpr (external $b.ModelPkg "WithLaw") }}({{ render . }}),
{{- end }}{{ end }}
{{- else if eq .ConcFamily "lease" }}
		{{ renderExpr (external .ModelPkg "WithConcurrent") }}({{ renderExpr (external .ModelPkg "ConcurrentConfig") }}[{{ renderType .IfaceRef }}]{
			// The lease-table model speaks the acquire/release vocabulary at
			// the oracle's own held identity; the nil free arm is the lenient
			// release both the oracle and the corpus subject speak. The op
			// spellings are the model's canonical vocabulary — it switches on
			// them, and an alias checks nothing.
			Model: {{ renderExpr (external .LinearizePkg "LeaseTable") }}({{ with .LeaseHeld }}{{ if .Sym }}{{ renderExpr .Sym }}{{ else }}{{ .Name }}{{ end }}{{ end }}, nil),
			Actions: []{{ renderExpr (external .ModelPkg "ConcurrentAction") }}[{{ renderType .IfaceRef }}]{
				{{ renderExpr (external .LinearizePkg "ConcurrentWriter") }}({{ renderExpr (external .LinearizePkg "OpAcquire") }}, keys,
					func({{ if .ConcAcquire.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}, k {{ renderType .Keys.Type }}) error {
						return s.{{ .ConcAcquire.Method }}({{ if .ConcAcquire.TakesCtx }}ctx, {{ end }}k)
					}, func(k {{ renderType .Keys.Type }}) {{ renderType .Keys.Type }} { return k }),
				{{ renderExpr (external .LinearizePkg "ConcurrentWriter") }}({{ renderExpr (external .LinearizePkg "OpRelease") }}, keys,
					func({{ if .ConcRelease.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}, k {{ renderType .Keys.Type }}) error {
						return s.{{ .ConcRelease.Method }}({{ if .ConcRelease.TakesCtx }}ctx, {{ end }}k)
					}, func(k {{ renderType .Keys.Type }}) {{ renderType .Keys.Type }} { return k }),
			},
		}),
{{- else if eq .ConcFamily "cas" }}
		{{ renderExpr (external .ModelPkg "WithConcurrent") }}({{ renderExpr (external .ModelPkg "ConcurrentConfig") }}[{{ renderType .IfaceRef }}]{
			// The cell model speaks the live oracle's own dialect — the stamp
			// is seen+1 and an empty cell matches only the zero version. The
			// mismatch is the declaration's stamped identity, the same one the
			// sequential oracle consumes; the subject's own empty error is not
			// knowable here, and nil reads any non-nil answer on an empty cell
			// as the miss. The op spellings are the model's canonical
			// vocabulary — it switches on them, and an alias checks nothing.
			Model: {{ renderExpr (external .LinearizePkg "CASCell") }}[{{ renderType .Reference.ContractArg }}, int64](nil, {{ with .CasMismatch }}{{ if .Sym }}{{ renderExpr .Sym }}{{ else }}{{ .Name }}{{ end }}{{ end }},
				func(v {{ renderType .Reference.ContractArg }}) int64 { return int64(v.{{ .Reference.VersionField }}) },
				func(ver int64) int64 { return ver + 1 }),
			Actions: []{{ renderExpr (external .ModelPkg "ConcurrentAction") }}[{{ renderType .IfaceRef }}]{
				{{ renderExpr (external .LinearizePkg "ConcurrentCAS") }}({{ renderExpr (external .LinearizePkg "OpCAS") }}, {{ .ConcWriter.Pool }},
					func({{ if .ConcWriter.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}, v {{ renderType .Reference.ContractArg }}) error {
						return s.{{ .ConcWriter.Method }}({{ if .ConcWriter.TakesCtx }}ctx, {{ end }}v)
					}),
				{{ renderExpr (external .LinearizePkg "ConcurrentCellReader") }}({{ renderExpr (external .LinearizePkg "OpGet") }},
					func({{ if .ConcReader.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}) ({{ renderType .Reference.ContractArg }}, error) {
						return s.{{ .ConcReader.Method }}({{ if .ConcReader.TakesCtx }}ctx{{ end }})
					}),
			},
		}),
{{- else if eq .ConcFamily "append" }}
		{{ renderExpr (external .ModelPkg "WithConcurrent") }}({{ renderExpr (external .ModelPkg "ConcurrentConfig") }}[{{ renderType .IfaceRef }}]{
			// One shared history: concurrent appends must answer the offsets
			// of one linearizable order. The monotonic-offsets law states the
			// claim per client; this leg states it across them, which is
			// where a torn append hides. The op spelling is the model's
			// canonical vocabulary.
			Model: {{ renderExpr (external .LinearizePkg "AppendLog") }}[{{ renderType .ConcEntry }}](),
			Actions: []{{ renderExpr (external .ModelPkg "ConcurrentAction") }}[{{ renderType .IfaceRef }}]{
				{{ renderExpr (external .LinearizePkg "ConcurrentAppend") }}({{ renderExpr (external .LinearizePkg "OpAppend") }}, {{ .ConcWriter.Pool }},
					func({{ if .ConcWriter.TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .IfaceRef }}, v {{ renderType .ConcEntry }}) (int64, error) {
						return s.{{ .ConcWriter.Method }}({{ if .ConcWriter.TakesCtx }}ctx, {{ end }}v)
					}),
			},
		}),
{{- end }}
	)
}
{{ end }}
{{- if .Reference.Derived }}
{{ if and (not .Reference.Collects) (not .Reference.IsContract) (not .Reference.MissSym) -}}
// {{ .Reference.MissName }} is what the reference reports for a key nothing
// wrote. Only its presence is compared — a subject reports its own miss
// sentinel, and the run asks whether both sides missed, not how they spelled
// it. Where the declaration stamps a sentinel of its own, the oracle takes
// that identity instead and this var is not declared.
var {{ .Reference.MissName }} = {{ renderExpr (external "errors" "New") }}("{{ .MissPrefix }}: the model reference holds nothing under the key")

{{ end -}}
{{ if .Reference.KeyField -}}
// {{ .KeyOfName }} projects a value's identity — the one derivation the
// reference keys on and every keyed law reuses, so the two cannot disagree
// about which field is the key.
func {{ .KeyOfName }}(v {{ renderType .Values.Type }}) {{ renderType .Keys.Type }} {
	return v.{{ .Reference.KeyField }}
}

{{ end -}}
{{ if .Reference.IsContract -}}
{{ if .Reference.VersionField -}}
// {{ lower .IfaceName }}ModelVersionOf projects a value's version — the one
// derivation the cell guards writes by, shared so the oracle and any law
// cannot disagree about which field is the guard.
func {{ lower .IfaceName }}ModelVersionOf(v {{ renderType .Reference.ContractArg }}) int64 {
	return v.{{ .Reference.VersionField }}
}

{{ end -}}
{{ range .Reference.CtorErrs }}{{ if .Name -}}
// {{ .Name }} is the oracle's spelling; only its presence is compared, so a
// subject reporting its own error under the same state agrees with it.
var {{ .Name }} = {{ renderExpr (external "errors" "New") }}("{{ $b.MissPrefix }}: {{ .Msg }}")

{{ end }}{{ end -}}
// {{ .Reference.TypeName }} adapts the shipped {{ .Reference.StoreType }} oracle — the
// {{ .Reference.ContractName }} contract's own semantics — to {{ .IfaceName }}.
// Deliberately simple: its correctness is read, not tested.
type {{ .Reference.TypeName }} struct {
	store *{{ renderExpr (external .RefPkg .Reference.StoreType) }}[{{ renderType .Reference.ContractArg }}]
}

func {{ .Reference.CtorName }}() {{ renderType .IfaceRef }} {
	return &{{ .Reference.TypeName }}{store: {{ renderExpr (external .RefPkg (printf "New%s" .Reference.StoreType)) }}[{{ renderType .Reference.ContractArg }}](
{{- if .Reference.VersionField }}
		{{ lower .IfaceName }}ModelVersionOf,
{{- end }}
{{- range .Reference.CtorFns }}
