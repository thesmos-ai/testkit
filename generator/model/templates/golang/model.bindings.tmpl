// no derivation can invent. Every law reading it arms only under this
// option; unarmed, the header still names the door.
func {{ $b.IfaceName }}Model{{ .Field }}(fn {{ template "model.suppliedtype" . }}) {{ $b.OptionTypeName }} {
	return func(c *{{ $b.ConfigName }}) { c.{{ .Config }} = fn }
}
