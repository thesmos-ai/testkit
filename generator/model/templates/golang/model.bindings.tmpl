{{- /*
The model tier's declarations for one interface: the pools its sequences
draw from, the reference they are compared against, the operation
vocabulary they drive, the laws they carry, and one body per row.

Rendered into the harness generator's own file rather than a file of this
tier's own, because the rows land on one run surface: a claim's checks sit
beside the checks they are compared against, and a consumer reads one
generated file per interface.
*/ -}}
{{- define "model.bindings" -}}
{{ $b := . }}
// --- {{ .IfaceName }}'s model tier -------------------------------------------
//
// Random sequences of {{ .IfaceName }}'s methods, run against every subject and
// something that judges them from outside. The rows on the run surface
// above carry it, and {{ .VeneerVar }}.Without declines any of them by name.
//
{{- template "model.header" . }}

{{- if .NeedsKeysPool }}

// {{ .KeysFuncName }} is the pool every key slot draws from.
{{- if .KeysReachAWrite }}
//
// Two members, and deliberately not more: collision density is what makes
// a read revisit a write and an overwrite land on held state. A wide pool
// would pass every comparison over a history that never collides.
{{- else }}
//
// Two members, and deliberately not more. Nothing here writes, so what a
// second one buys is a call asking for what an earlier call already asked
// for; a pool wide enough that every draw is a first would compare nothing
// against anything.
{{- end }}
func {{ .KeysFuncName }}(fx {{ .FixtureTypeName }}) *{{ renderExpr (external .ModelPkg "Generator") }}[{{ renderType .Keys.Type }}] {
{{- if and .Keys.Hostile .Keys.PoolField }}
	return {{ if .Keys.Identity }}{{ renderExpr (external .LegsPkg "BlendStrings") }}(fx.{{ .Keys.PoolField }}Derived(),
		{{ renderExpr (external .ModelPkg "SampledFrom") }}(fx.{{ .Keys.PoolField }}()),
	){{ else }}{{ renderExpr (external .LegsPkg "Blend") }}(fx.{{ .Keys.PoolField }}Derived(),
		{{ renderExpr (external .ModelPkg "SampledFrom") }}(fx.{{ .Keys.PoolField }}()),
		func(s string) {{ renderType .Keys.Type }} { return {{ renderType .Keys.Type }}(s) },
	){{ end }}
{{- else if .Keys.Hostile }}
	// Widened unconditionally: this run emits no config, so there is no
	// pool a consumer could have narrowed and nothing to gate on. The
	// provenance argument applies to a pool somebody passed, and nobody
	// can pass one here.
	return {{ if .Keys.Identity }}{{ renderExpr (external .LegsPkg "BlendStrings") }}(true,
		{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Keys.Type }}{ {{ .Keys.Read }}, {{ .Keys.OtherRead }} }),
	){{ else }}{{ renderExpr (external .LegsPkg "Blend") }}(true,
		{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Keys.Type }}{ {{ .Keys.Read }}, {{ .Keys.OtherRead }} }),
		func(s string) {{ renderType .Keys.Type }} { return {{ renderType .Keys.Type }}(s) },
	){{ end }}
{{- else if .Keys.PoolField }}
	return {{ renderExpr (external .ModelPkg "SampledFrom") }}(fx.{{ .Keys.PoolField }}())
{{- else }}
	return {{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Keys.Type }}{ {{ .Keys.Read }}, {{ .Keys.OtherRead }} })
{{- end }}
}
{{- end }}
{{- if .NeedsValuesPool }}

// {{ .ValuesFuncName }} is the value pool every value slot draws from.
{{- if .Values.GenFunc }}
//
// The fixture pair blended with {{ .Values.GenFunc }}'s draws — the gen= supply,
// for a domain no reflection walk can spell.
{{- else if .Values.Wide }}
//
// The fixture pair blended with arbitrary draws: the pair keeps identical
// rewrites frequent, the wide arm reaches values no fixture spells, and
// nothing in the claims licenses refusing either.
{{- else if .Values.Hostile }}
//
// The run's whole {{ .Values.PoolField }}, widened with the hostile half of
// the string space where the pool was DERIVED and left verbatim where you
// passed one. A derived pool is a guess from the type and attacking a
// guess costs nothing; a pool you passed is a statement about what the
// implementation accepts, and probing past it reds correct code against
// inputs you ruled out.
{{- else if .Values.PoolField }}
//
// The run's whole {{ .Values.PoolField }}, which is the pair plus whatever
// else it holds. A pool derived from the type carries a hostile member the
// transforms added; a pool you passed carries exactly what you passed. So
// the guess gets attacked and your statement about what the implementation
// accepts is taken at its word, with no flag deciding which.
{{- else }}
//
// The fixture pair alone — {{ .Values.WhyNarrow }}.
{{- end }}
func {{ .ValuesFuncName }}(fx {{ .FixtureTypeName }}) *{{ renderExpr (external .ModelPkg "Generator") }}[{{ renderType .Values.Type }}] {
{{- if .Values.Pin }}
	keys := {{ .KeysFuncName }}(fx)
{{- end }}
	bodies := {{ template "model.bodies" . }}
{{- if .Values.Pin }}
	// Every drawn value lands on a pooled key: a key rewritten under
	// another body is the history latest-write-wins is about, and a
	// fresh-keyed value would never collide with one already held.
	return {{ renderExpr (external .ModelPkg "Custom") }}(func(t *{{ renderExpr (external .ModelPkg "T") }}) {{ renderType .Values.Type }} {
		v := bodies.Draw(t, "value_body")
		v.{{ .Values.Pin }} = keys.Draw(t, "value_key")
		return v
	})
{{- else }}
	return bodies
{{- end }}
}
{{- end }}
{{- if .Reference.Derived }}
{{ if and (not .Reference.Collects) (not .Reference.IsContract) (not .Reference.MissSym) }}
// {{ .Reference.MissName }} is what the reference reports for a key nothing
// wrote. Only its presence is compared — a subject reports its own miss
// sentinel, and the run asks whether both sides missed, not how they spelled
// it. Where the declaration stamps a sentinel of its own, the oracle takes
// that identity instead and this var is not declared.
var {{ .Reference.MissName }} = {{ renderExpr (external "errors" "New") }}("{{ .MissPrefix }}: the model reference holds nothing under the key")
{{ end }}
{{- if .Reference.KeyField }}
// {{ .KeyOfName }} projects a value's identity — the one derivation the
// reference keys on and every keyed law reuses, so the two cannot disagree
// about which field is the key.
func {{ .KeyOfName }}(v {{ renderType .Values.Type }}) {{ renderType .Keys.Type }} {
	return v.{{ .Reference.KeyField }}
}
{{ end }}
{{- if .Reference.IsContract }}
{{- if .Reference.VersionField }}
// {{ lower .IfaceName }}ModelVersionOf projects a value's version — the one
// derivation the cell guards writes by, shared so the oracle and any law
// cannot disagree about which field is the guard.
func {{ lower .IfaceName }}ModelVersionOf(v {{ renderType .Reference.ContractArg }}) int64 {
	return v.{{ .Reference.VersionField }}
}
{{ end }}
{{- range .Reference.CtorErrs }}{{ if .Name }}
// {{ .Name }} is the oracle's spelling; only its presence is compared, so a
// subject reporting its own error under the same state agrees with it.
var {{ .Name }} = {{ renderExpr (external "errors" "New") }}("{{ $b.MissPrefix }}: {{ .Msg }}")
{{ end }}{{ end }}
// {{ .Reference.TypeName }} adapts the shipped {{ .Reference.StoreType }} oracle — the
// {{ .Reference.ContractName }} contract's own semantics — to {{ .IfaceName }}.
// Deliberately simple: its correctness is read, not tested.
type {{ .Reference.TypeName }} struct {
	store *{{ renderExpr (external .RefPkg .Reference.StoreType) }}[{{ renderType .Reference.ContractArg }}]
}

// {{ .Reference.CtorName }} builds one. Exported because a consumer whose
// semantics outrun their shape replaces it, and because the proof beside
// this file drives it as a subject of its own.
func {{ .Reference.CtorName }}() {{ .SubjectSpelling }} {
	return &{{ .Reference.TypeName }}{store: {{ renderExpr (external .RefPkg (printf "New%s" .Reference.StoreType)) }}[{{ renderType .Reference.ContractArg }}](
{{- if .Reference.VersionField }}
		{{ lower .IfaceName }}ModelVersionOf,
{{- end }}
{{- range .Reference.CtorFns }}
		{{ renderExpr (external $b.RefPkg .) }}[{{ renderType $b.Reference.ContractArg }}](),
{{- end }}
{{- range .Reference.CtorErrs }}
		{{ if .Sym }}{{ renderExpr .Sym }}{{ else if .Name }}{{ .Name }}{{ else }}nil{{ end }},
{{- end }}
	)}
}
{{ else }}
// {{ .Reference.TypeName }} adapts the shipped {{ .Reference.StoreType }} oracle to {{ .IfaceName }}.
// Deliberately simple: its correctness is read, not tested.
type {{ .Reference.TypeName }} struct {
	store *{{ renderExpr (external .RefPkg .Reference.StoreType) }}[{{ if not .Reference.Collects }}{{ renderType .Keys.Type }}, {{ end }}{{ renderType .Values.Type }}]
}

// {{ .Reference.CtorName }} builds one. Exported because a consumer whose
// semantics outrun their shape replaces it, and because the proof beside
// this file drives it as a subject of its own.
func {{ .Reference.CtorName }}() {{ .SubjectSpelling }} {
	return &{{ .Reference.TypeName }}{store: {{ renderExpr (external .RefPkg (printf "New%s" .Reference.StoreType)) }}[{{ if not .Reference.Collects }}{{ renderType .Keys.Type }}, {{ end }}{{ renderType .Values.Type }}](
{{- if not .Reference.Collects }}
{{- if not .Reference.Keyed }}
		{{ .KeyOfName }},
{{- end }}
		{{ if .Reference.MissSym }}{{ renderExpr .Reference.MissSym }}{{ else }}{{ .Reference.MissName }}{{ end }},
{{- end }}
	)}
}
{{ end }}
{{- range .Adapter }}
{{- if and .Op .Collect }}
// {{ .Sig.Name }} drains the oracle's iterator into the slice the contract
// answers — the one seam between the two spellings of a replay.
func (r *{{ $b.Reference.TypeName }}) {{ .Sig.Name }}({{ template "model.params" .Sig }}) {{ template "model.results" .Sig }} {
	out := {{ renderType (index .Sig.Returns 0).Type }}{}
	for e, err := range r.store.{{ .Op }}({{ range $i, $p := .Sig.Params }}{{ if $i }}, {{ end }}{{ $p.Name }}{{ end }}) {
		if err != nil {
			return nil, err
		}
		out = append(out, e)
	}
	return out, nil
}
{{ else if and .Op .Folds }}
// {{ .Sig.Name }} folds the oracle's miss into the presence flag this
// interface answers with. Absence is an answer here rather than a failure,
// and the oracle spells the same non-answer as a store does — so the two
// spellings meet once, in this line, instead of at every comparison.
func (r *{{ $b.Reference.TypeName }}) {{ .Sig.Name }}({{ template "model.params" .Sig }}) {{ template "model.results" .Sig }} {
	held, err := r.store.{{ .Op }}({{ range $i, $p := .Sig.Params }}{{ if $i }}, {{ end }}{{ $p.Name }}{{ end }})
	return held, err == nil
}
{{ else if .Op }}
func (r *{{ $b.Reference.TypeName }}) {{ .Sig.Name }}({{ template "model.params" .Sig }}) {{ template "model.results" .Sig }} {
	return r.store.{{ .Op }}({{ range $i, $p := .Sig.Params }}{{ if $i }}, {{ end }}{{ $p.Name }}{{ end }})
}
{{ else }}
// {{ .Sig.Name }} is inert: {{ .Reason }}. The laws that would compare the
// subject against an inert body are not bound.
func (r *{{ $b.Reference.TypeName }}) {{ .Sig.Name }}({{ template "model.params" .Sig }}) {{ template "model.zeroresults" .Sig }}
{{ end }}
{{- end }}
{{- end }}
{{- if .Session }}
// {{ .Session.ClassifyName }} interprets one trace event as a per-client
// operation: the ordering stamp rides the value's {{ .Session.VersionField }} member, and an
// errored call classifies nothing — a miss's zero value is not a version.
{{- if not .Session.Writer }}
// Writes classify nothing here: the writer answers only an error, so the
// version the store assigned never reaches the trace.
{{- end }}
func {{ .Session.ClassifyName }}(ev {{ renderExpr (external .TracePath "Event") }}) ({{ renderExpr (external .LawPath "ClientOp") }}[{{ renderType .Session.Key }}], bool) {
	if ev.Err != nil {
		return {{ renderExpr (external .LawPath "ClientOp") }}[{{ renderType .Session.Key }}]{}, false
	}
	switch ev.Method {
	case "{{ .Session.Reader }}":
		v, ok := ev.Output.({{ renderType .Session.Value }})
		if !ok {
			return {{ renderExpr (external .LawPath "ClientOp") }}[{{ renderType .Session.Key }}]{}, false
		}
		return {{ renderExpr (external .LawPath "ClientOp") }}[{{ renderType .Session.Key }}]{Key: v.{{ .Session.KeyField }}, Version: int64(v.{{ .Session.VersionField }})}, true
{{- if .Session.Writer }}
	case "{{ .Session.Writer }}":
		v, ok := ev.Output.({{ renderType .Session.Value }})
		if !ok {
			return {{ renderExpr (external .LawPath "ClientOp") }}[{{ renderType .Session.Key }}]{}, false
		}
		return {{ renderExpr (external .LawPath "ClientOp") }}[{{ renderType .Session.Key }}]{Write: true, Key: v.{{ .Session.KeyField }}, Version: int64(v.{{ .Session.VersionField }})}, true
{{- end }}
	}
	return {{ renderExpr (external .LawPath "ClientOp") }}[{{ renderType .Session.Key }}]{}, false
}
{{ end }}
{{- if .Publisher }}
// {{ .Publisher.DrainName }} sweeps what Publish already delivered, asserting
// synchronous fan-out: everything a subscriber is owed is in its channel by
// the time Publish returns. An asynchronous publisher's in-flight deliveries
// read as loss here, which is the floor this states and not more.
func {{ .Publisher.DrainName }}(_ *{{ renderExpr (external .ModelPkg "T") }}, _ {{ .SubjectSpelling }}, sub {{ renderType .Publisher.Sub }}) ([]{{ renderType .Publisher.Msg }}, error) {
	var got []{{ renderType .Publisher.Msg }}
	for {
		select {
		case v := <-sub:
			got = append(got, v)
		default:
			return got, nil
		}
	}
}
{{ end }}
// {{ .ActionsFuncName }} is the operation vocabulary both legs drive.
//
// One constructor per method shape, from the engine's action set rather
// than hand-written closures: the constructors record inputs and outputs
// into the trace a law reads, compare the two sides the same way for every
// action, and shrink a failing sequence to the shortest one that still
// fails.
func {{ .ActionsFuncName }}({{ template "model.declparams" . }}) []{{ renderExpr (external .ModelPkg "Action") }}[{{ .SubjectSpelling }}] {
{{- if .ActionsUseKeys }}
	keys := {{ .KeysFuncName }}(fx)
{{- end }}
{{- if .UsesValues }}
	values := {{ .ValuesFuncName }}(fx)
{{- end }}
	out := []{{ renderExpr (external .ModelPkg "Action") }}[{{ .SubjectSpelling }}]{
{{- range .Actions }}
		{{ render . }},
{{- end }}
	}
{{- if .Delivery }}
	// The subscription pair, three actions sharing two open handles: one
	// opens them, one publishes to both, one compares what each has
	// delivered so far. Appended rather than listed above because they
	// come as a set — see the action package's Delivery, which says why
	// the comparison has to span steps rather than close its own cycle.
	out = append(out, {{ renderExpr (external .ActionPkg "NewDelivery") }}[{{ .SubjectSpelling }}, {{ renderType .Delivery.Msg }}](
		{{ printf "%q" .Delivery.Name }},
		func({{ if .Delivery.SubscribeCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ .SubjectSpelling }}) ({{ renderType .Delivery.Sub }}, error) {
			return s.{{ .Delivery.Subscribe }}({{ if .Delivery.SubscribeCtx }}ctx{{ end }})
		},
		func({{ if .Delivery.PublishCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ .SubjectSpelling }}, m {{ renderType .Delivery.Msg }}) error {
			return s.{{ .Delivery.Publish }}({{ if .Delivery.PublishCtx }}ctx, {{ end }}m)
		},
		values, {{ renderExpr .Delivery.Mode }},
	).Actions()...)
{{- end }}
	return out
}
{{ if .LegLaws }}
// {{ .LawsFuncName }} is the laws the classifications earned and this build
// could fill.
//
// Observational, every one of them: a law never mutates, so running them
// inside the sequences is safe for every step that follows. What they
// judge is the subject's own behaviour, which is why they are a separate
// leg from the reference comparison rather than more oracles on it.
func {{ .LawsFuncName }}({{ template "model.lawparams" . }}) []{{ renderExpr (external .LawPath "Law") }}[{{ .SubjectSpelling }}] {
{{- if .LawsUseKeys }}
	keys := {{ .KeysFuncName }}(fx)
{{- end }}
{{- if .LawsUseValues }}
	values := {{ .ValuesFuncName }}(fx)
{{- end }}
{{- template "model.lawpools" . }}
{{- if .Publisher }}
	drainSub := {{ .Publisher.DrainName }}
{{- end }}
{{- if .Coalesced }}
	// The coalescing law's own instrumentation: its compute increments this
	// under the lock, because a subject that fails to coalesce invokes it
	// concurrently.
	coalesceCalls := 0
	var coalesceMu {{ renderExpr (external "sync" "Mutex") }}
{{- end }}
	return []{{ renderExpr (external .LawPath "Law") }}[{{ .SubjectSpelling }}]{
{{- range .LegLaws }}
		{{ render . }},
{{- end }}
	}
}
{{ end }}
{{- range .Legs }}
{{ render . }}
{{ end }}
{{- end -}}

{{- /*
model.declparams spells the parameter list every declaration below shares:
the run's sample inputs where anything reads them, and the append log where
a law reads what the sequences attempted.
*/ -}}
{{- define "model.declparams" -}}
{{- $sep := "" -}}
{{- if .NeedsFixture }}fx {{ .FixtureTypeName }}{{ $sep = ", " }}{{ end }}
{{- if .RecordsHistory }}{{ $sep }}appendHist *{{ renderExpr (external .HistoryPkg "History") }}[string, {{ renderType .HistoryElem }}]{{ end -}}
{{- end -}}

{{- /*
model.lawparams is model.declparams and the subject factory, for the laws
that build instances of their own — a merge claim compares two replicas,
and no observation over one states it. The leg has the subject in hand and
this function does not, so it arrives as a parameter.
*/ -}}
{{- define "model.lawparams" -}}
{{- $sep := "" -}}
{{- if .NeedsFixture }}fx {{ .FixtureTypeName }}{{ $sep = ", " }}{{ end }}
{{- if .RecordsHistory }}{{ $sep }}appendHist *{{ renderExpr (external .HistoryPkg "History") }}[string, {{ renderType .HistoryElem }}]{{ $sep = ", " }}{{ end }}
{{- if .LawsNeedFactory }}{{ $sep }}factory func() {{ .SubjectSpelling }}{{ end -}}
{{- end -}}

{{- /*
model.bodies spells the value pool's unpinned generator.
*/ -}}
{{- define "model.bodies" -}}
{{- if .Values.GenFunc }}{{ renderExpr (external .ModelPkg "OneOf") }}(
		{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{ {{ .Values.Read }}, {{ .Values.OtherRead }} }),
		{{ .Values.GenFunc }}(),
	)
{{- else if .Values.Wide }}{{ renderExpr (external .ModelPkg "OneOf") }}(
		{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{ {{ .Values.Read }}, {{ .Values.OtherRead }} }),
		{{ renderExpr (external .ModelPkg "Make") }}[{{ renderType .Values.Type }}](),
	)
{{- else if and .Values.Hostile .Values.PoolField }}{{ if .Values.Identity }}{{ renderExpr (external .LegsPkg "BlendStrings") }}(fx.{{ .Values.PoolField }}Derived(),
		{{ renderExpr (external .ModelPkg "SampledFrom") }}(fx.{{ .Values.PoolField }}()),
	){{ else }}{{ renderExpr (external .LegsPkg "Blend") }}(fx.{{ .Values.PoolField }}Derived(),
		{{ renderExpr (external .ModelPkg "SampledFrom") }}(fx.{{ .Values.PoolField }}()),
		func(s string) {{ renderType .Values.Type }} { return {{ renderType .Values.Type }}(s) },
	){{ end }}
{{- else if .Values.Hostile }}{{ if .Values.Identity }}{{ renderExpr (external .LegsPkg "BlendStrings") }}(true,
		{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{ {{ .Values.Read }}, {{ .Values.OtherRead }} }),
	){{ else }}{{ renderExpr (external .LegsPkg "Blend") }}(true,
		{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{ {{ .Values.Read }}, {{ .Values.OtherRead }} }),
		func(s string) {{ renderType .Values.Type }} { return {{ renderType .Values.Type }}(s) },
	){{ end }}
{{- else if .Values.PoolField }}{{ renderExpr (external .ModelPkg "SampledFrom") }}(fx.{{ .Values.PoolField }}())
{{- else }}{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{ {{ .Values.Read }}, {{ .Values.OtherRead }} })
{{- end -}}
{{- end -}}

{{- /*
model.header is the prose above the block: what the sequences drive, what
judges them, and — at least as important — what they do not.
*/ -}}
{{- define "model.header" -}}
{{- if .Reference.Supplied }}
//	Reference: supplied through //testkit:model ref=
{{- else if .Reference.Twin }}
//	Reference: the subject's own factory — {{ .Reference.TwinWhy }},
//	           so a second instance driven identically stands in: twins must
//	           agree, which catches nondeterminism and hidden shared state but
//	           not a subject wrong the same way twice; ref= raises the floor
{{- else if .Reference.IsContract }}
//	Reference: derived — the {{ .Reference.StoreType }} oracle, which is the
//	           {{ .Reference.ContractName }} contract's own semantics; {{ .Reference.CtorName }} replaces it
{{- else if .Reference.Collects }}
//	Reference: derived — an append-and-drain collection over the
//	           {{ .Values.Field }} fixture pair; {{ .Reference.CtorName }} replaces it
{{- else if .Reference.Keyed }}
//	Reference: derived — a keyed store over the {{ .Keys.Field }} and
//	           {{ .Values.Field }} fixture pairs; {{ .Reference.CtorName }} replaces it
{{- else }}
//	Reference: derived — a {{ if .Reference.Pins }}resolution-pinning{{ else }}keyed{{ end }} map over the {{ .Values.Field }} fixture pair,
//	           keyed on {{ .Reference.KeyField }}; {{ .Reference.CtorName }} replaces it
{{- end }}
//	Sequences: {{ range $i, $a := .Actions }}{{ if $i }}, {{ end }}{{ $a.Method }} ({{ $a.Shape }}){{ end }}
{{- if .Witnesses }}
//	Witnesses: the sequences run at {{ renderType .IfaceRef }} — the types
//	           the source's witness= names, one per type parameter
{{- end }}
{{- if .Session }}
//	Sessions:  per-client laws read {{ .Session.VersionField }} off {{ .Session.Reader }}'s value
{{- end }}
{{- if .Publisher }}
//	Drain:     derived — a non-blocking sweep asserting fan-out synchronous
//	           with Publish; an async subject reads as loss against this floor
{{- end }}
{{- if .NeedsValuesPool }}
{{- if .Values.GenFunc }}
//	Values:    the fixture pair blended with {{ .Values.GenFunc }}'s draws — the gen= supply
{{- else if .Values.Wide }}
//	Values:    the fixture pair blended with arbitrary draws{{ if .Values.Pin }}, each keyed
//	           from the pool{{ end }}
{{- else }}
//	Values:    the fixture pair — {{ .Values.WhyNarrow }}
{{- end }}
{{- end }}
{{- with .LegLaws }}
//	Laws:      {{ range $i, $l := . }}{{ if $i }}, {{ end }}{{ $l.ID }}{{ if $l.Unarmed }} (unarmed: {{ range $j, $u := $l.Unarmed }}{{ if $j }}, {{ end }}{{ $u }}{{ end }}){{ end }}{{ end }}
{{- end }}
{{- with .Skipped }}
//	Not driven:
{{- range . }}
//	           {{ .Method }} — {{ .Reason }}
{{- end }}
{{- end }}
{{- with .Unbound }}
//	Not bound:
{{- range . }}
//	           {{ .Method }} — {{ .Reason }}
{{- end }}
{{- end }}
{{- end -}}

{{- /*
model.lawpools declares the pools the laws bring beyond the shared pair.
*/ -}}
{{- define "model.lawpools" -}}
{{- range .LegLawPools }}
{{- if .Adversarial }}
	// The {{ .Name }} pool is the laws' own: hostile strings beside arbitrary
	// ones, because a safety claim never probed with an attack is vacuous.
	{{ .Name }} := {{ renderExpr (external $.ModelPkg "AdversarialStrings") }}()
{{- else if .Offsets }}
	// The {{ .Name }} pool draws bounded schedule offsets: within the law's
	// own advance horizon, and never in the past nothing promises.
	{{ .Name }} := {{ renderExpr (external $.ModelPkg "Map") }}(
		{{ renderExpr (external $.ModelPkg "Int64Range") }}(0, {{ renderExpr (external "time" "Second") }}.Nanoseconds()*10),
		func(n int64) {{ renderExpr (external "time" "Duration") }} { return {{ renderExpr (external "time" "Duration") }}(n) },
	)
{{- else }}
	// The {{ .Name }} pool is the laws' own: a wide domain for a stateless
	// claim, which the colliding pair deliberately does not serve.
	{{ .Name }} := {{ renderExpr (external $.ModelPkg "Make") }}[{{ renderType .Elem }}]()
{{- end }}
{{- end }}
{{- end -}}

{{- /*
model.params spells a signature's parameter list verbatim.
*/ -}}
{{- define "model.params" -}}
{{- range $i, $p := .Params }}{{ if $i }}, {{ end }}{{ $p.Name }} {{ renderType $p.Type }}{{ end -}}
{{- end -}}

{{- /*
model.results spells the return clause for a delegating body.
*/ -}}
{{- define "model.results" -}}
{{- if eq (len .Returns) 1 }}{{ renderType (index .Returns 0).Type }}
{{- else if .Returns }}({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}{{ renderType $r.Type }}{{ end }})
{{- end -}}
{{- end -}}

{{- /*
model.zeroresults names every return so an inert body is one naked return of
zero values, whatever the signature — no per-type zero spelling to get wrong.
*/ -}}
{{- define "model.zeroresults" -}}
{{- if .Returns }}({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}r{{ $i }} {{ renderType $r.Type }}{{ end }}) { return }
{{- else }}{}
{{- end -}}
{{- end -}}

{{- /*
model.suppliedtype spells one supplied door's closure type at the fixture's
own instantiation.
