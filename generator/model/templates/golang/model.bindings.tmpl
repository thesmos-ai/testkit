{{ if .SatLaws -}}
// {{ lower .IfaceName }}ModelOnlyLaw narrows the run to one law.
//
// Unexported: this is the saturation prover's instrument, not a knob. A
// conformance run asserts every law the classifications earned, and dropping
// all but one is only ever right when the question is "can this law fail",
// which is the one question the prover asks.
//
// Without it the prover cannot answer that question at all. The runner stops
// the iteration at the first law that fails, so a defect worn for law A is
// reported under whichever law happens to catch it first — the corpus showed
// 114 such runs, each one a law that looked unsaturatable because a sibling
// spoke over it.
func {{ lower .IfaceName }}ModelOnlyLaw(id string) {{ .OptionTypeName }} {
	return func(c *{{ .ConfigName }}) { c.onlyLaw = id }
}

