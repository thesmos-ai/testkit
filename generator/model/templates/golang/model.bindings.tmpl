// with Publish and would read in-flight deliveries as loss.
func {{ .IfaceName }}ModelDrain(fn func(*{{ renderExpr (external .ModelPkg "T") }}, {{ renderType .IfaceRef }}, {{ renderType .Publisher.Sub }}) ([]{{ renderType .Publisher.Msg }}, error)) {{ .OptionTypeName }} {
	return func(c *{{ .ConfigName }}) { c.drain = fn }
}
{{ end }}
// {{ .IfaceName }}ModelClocked supplies a factory that builds the subject on
// the run's own test clock — what arms the aging laws, whose Advance moves
// exactly the time the subject reads. Without it those laws stay dropped,
// and the header says so.
func {{ .IfaceName }}ModelClocked(build func(clk *{{ renderExpr (external .ClockPkg "TestClock") }}) {{ renderType .IfaceRef }}) {{ .OptionTypeName }} {
	return func(c *{{ .ConfigName }}) { c.clocked = build }
}
{{ end -}}
{{ if .UsesValues }}
// {{ .IfaceName }}ModelValues replaces the values pool — for a subject whose
// accepted values a raw draw cannot spell. The pool feeds every value slot,
// the sequences and the laws alike; keep its draws colliding, because values
// that never revisit a key pass every comparison over a history that holds
// nothing twice.
func {{ .IfaceName }}ModelValues(values *{{ renderExpr (external .ModelPkg "Generator") }}[{{ renderType .Values.Type }}]) {{ .OptionTypeName }} {
	return func(c *{{ .ConfigName }}) { c.values = values }
}
