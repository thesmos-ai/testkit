{{- /*
model.pools declares the shared pools — one spelling for the sequential and
concurrent legs, because a leg drawing from anywhere else could stop
colliding without anyone noticing.
*/ -}}
{{- define "model.pools" -}}
{{- if .UsesKeys }}
	// Two keys, drawn for every key slot: collision density is what makes a
	// read revisit a write and an overwrite land on held state. A wide key
	// pool would pass every comparison over a history that never collides.
	keys := {{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Keys.Type }}{fx.{{ .Keys.Field }}(), fx.{{ .Keys.OtherField }}()})
{{- end }}
{{- if .UsesValues }}
{{- if .Values.GenFunc }}
	// Bodies blend the fixture pair with {{ .Values.GenFunc }}'s draws — the
	// gen= supply, for a domain no reflection walk can spell.
	bodies := {{ renderExpr (external .ModelPkg "OneOf") }}(
		{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{fx.{{ .Values.Field }}(), fx.{{ .Values.OtherField }}()}),
		{{ .Values.GenFunc }}(),
	)
{{- else if .Values.Wide }}
	// Bodies blend the fixture pair with arbitrary draws: the pair keeps
	// identical rewrites frequent, the wide arm reaches values no fixture
	// spells — and nothing in the claims licenses refusing either.
	bodies := {{ renderExpr (external .ModelPkg "OneOf") }}(
		{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{fx.{{ .Values.Field }}(), fx.{{ .Values.OtherField }}()}),
		{{ renderExpr (external .ModelPkg "Make") }}[{{ renderType .Values.Type }}](),
	)
{{- else }}
	// Bodies keep to the fixture pair —
	// {{ .Values.WhyNarrow }}.
	bodies := {{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{fx.{{ .Values.Field }}(), fx.{{ .Values.OtherField }}()})
{{- end }}
{{- if .Values.Pin }}
	// Every drawn value lands on a pooled key: a key rewritten under another
	// body is the history latest-write-wins is about, and a fresh-keyed value
	// would never collide with one already held.
	values := {{ renderExpr (external .ModelPkg "Custom") }}(func(t *{{ renderExpr (external .ModelPkg "T") }}) {{ renderType .Values.Type }} {
		v := bodies.Draw(t, "value_body")
		v.{{ .Values.Pin }} = keys.Draw(t, "value_key")
		return v
	})
{{- else }}
	values := bodies
{{- end }}
	if cfg.values != nil {
		values = cfg.values
	}
{{- end }}
{{- end -}}

{{- /*
model.lawpools declares the pools the laws bring beyond the shared pair —
sequential leg only, because the laws run there and an unused local is a
compile error in a generated file.
*/ -}}
{{- define "model.lawpools" -}}
{{- range .LawPools }}
{{- if .Adversarial }}
	// The {{ .Name }} pool is the laws' own: hostile strings beside arbitrary
	// ones, because a safety claim never probed with an attack is vacuous.
	{{ .Name }} := {{ renderExpr (external $.ModelPkg "AdversarialStrings") }}()
{{- else if .Offsets }}
	// The {{ .Name }} pool draws bounded schedule offsets: within the law's
	// own advance horizon, and never in the past nothing promises.
	{{ .Name }} := {{ renderExpr (external $.ModelPkg "Map") }}(
		{{ renderExpr (external $.ModelPkg "Int64Range") }}(0, {{ renderExpr (external "time" "Second") }}.Nanoseconds()*10),
		func(n int64) {{ renderExpr (external "time" "Duration") }} { return {{ renderExpr (external "time" "Duration") }}(n) },
	)
{{- else }}
	// The {{ .Name }} pool is the laws' own: a wide domain for a stateless
	// claim, which the colliding pair deliberately does not serve.
	{{ .Name }} := {{ renderExpr (external $.ModelPkg "Make") }}[{{ renderType .Elem }}]()
{{- end }}
{{- end }}
{{- end -}}

