{{- /* Every cross-package symbol is composed with the backend's own
       `external <path> <Symbol>`, which registers the import as it renders.
       The testkit path comes off the emit value ($.Runtime) rather than being
       spelled here, so the day the module moves no template changes. */ -}}
{{- define "builder.test" -}}
{{- $T := external "testing" "T" -}}
{{- $equal := external $.Runtime "Equal" -}}
{{- $true := external $.Runtime "True" -}}
{{- $errorIs := external $.Runtime "ErrorIs" -}}
{{- $errorsNew := external "errors" "New" -}}
{{- $b := .TypeName -}}
{{- $src := .SourceName -}}
{{- $ta := .TypeArgs -}}
{{- $tp := renderTypeParams .TypeParams -}}
{{- $ctor := renderExpr .CtorRef -}}
{{- $val := renderExpr .ValueRef -}}
{{- if .Generic -}}
{{- /* A Go test function cannot take type parameters, and the field types are
       the type parameters, so the checks have to live in generic helpers a
       concrete entry point calls. Until that split exists the absence is
       stated rather than left as an empty file, which would read as a
       generator that failed. */ -}}
// Skipped: {{ $b }} is generic — instantiate it with concrete types and write
// the checks in the consuming package.
{{- else -}}
// TestNew{{ $src }} pins what the constructor seeds.
func TestNew{{ $src }}(t *{{ renderExpr $T }}) {
	t.Parallel()
{{- if and .Companion (not .Seeded) }}

	t.Run("seeds from the package companion", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Compared against the companion's own return rather than a value
		// restated here: anything weaker would pass against a constructor that
		// called something else, or nothing at all.
		{{ renderExpr $equal }}(t, {{ $ctor }}{{ $ta }}().Build(), {{ renderExpr .Companion }}{{ $ta }}(),
			"New{{ $src }} must seed from its companion")
	})
{{- else if .Seeded }}
{{- range .Fields }}{{ if .Default }}
{{- if .ZeroDefault }}

	// No check that New{{ $src }} seeds {{ .Name }}: its declared default is
	// the zero value, so the assertion would be `{{ .Default }} == {{ .Default }}`
	// and would pass for a constructor that ignored the directive. The
	// declaration still stands — the author is saying the zero is deliberate
	// — and nothing here can tell that apart from the zero arriving by
	// default.
{{- else }}

	t.Run("seeds {{ .Name }} with its declared default", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A default the constructor drops reads as a field the author never
		// declared, and every test built on it starts from the wrong value.
		{{ renderExpr $equal }}(t, {{ $ctor }}{{ $ta }}().Build().{{ .Name }}, {{ if .DefaultRef }}{{ renderExpr .DefaultRef }}{{ else }}{{ .Default }}{{ end }},
			"New{{ $src }} must seed {{ .Name }}")
	})
{{- end }}
{{- end }}{{ end }}
{{- else }}

	t.Run("returns a builder over the zero value", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		var zero {{ $val }}{{ $ta }}
		{{ renderExpr $equal }}(t, {{ $ctor }}{{ $ta }}().Build(), zero,
			"an unseeded builder starts from the zero value")
	})
{{- end }}
}

// TestNew{{ $src }}From pins the seeding constructor, which is what a test
// uses to vary one field of a value it already holds.
func TestNew{{ $src }}From(t *{{ renderExpr $T }}) {
	t.Parallel()

{{- with .Seedable }}
	t.Run("carries the value through untouched", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Anything it altered would be a field the caller did not ask to
		// change, which defeats the point of seeding from a value at all.
		//
		// Populated, not the zero value. `From(zero).Build() == zero` holds
		// for a constructor that drops every field it is handed, which is the
		// one defect this check exists to catch — so the seed is built
		// through the setters, each already proven above to reach its field.
		seed := {{ $ctor }}{{ $ta }}(){{ range . }}.With{{ .Name }}({{ renderSample .Sample }}){{ end }}.Build()
		{{ renderExpr $equal }}(t, {{ renderExpr $.FromRef }}{{ $ta }}(seed).Build(), seed,
			"New{{ $src }}From must not alter what it was given")
	})
{{- else }}

	// No round-trip check: no field of this struct admits a value this
	// generator can name, so the only seed available is the zero value and
	// comparing it against itself would pass against a constructor that
	// dropped everything.
{{- end }}
}
