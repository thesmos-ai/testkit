// Test{{ $b }}Build pins what the builder hands back.
func Test{{ $b }}Build(t *{{ renderExpr $T }}) {
	t.Parallel()

{{- with .Seedable }}
	t.Run("returns every field that was configured", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Every field set on the way, not a zero compared against itself:
		// a Build that answered the zero would satisfy the second form
		// however much had been configured.
		seed := {{ $ctor }}{{ $ta }}(){{ range . }}.With{{ .Name }}({{ renderSample .Sample }}){{ end }}.Build()
		{{ renderExpr $equal }}(t, {{ renderExpr $.FromRef }}{{ $ta }}(seed).Build(), seed,
			"Build returns the value under construction")
	})
{{- else }}

	// No check that Build returns what was configured: nothing here can be
	// configured to a value this generator can name.
{{- end }}
}
{{- end }}
{{- end -}}
